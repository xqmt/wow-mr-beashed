-- ============================================================
-- Hitbox Expander
-- ============================================================
local hitboxEnabled = false
local hitboxSize    = 8
local hitboxData    = {players = {}, npcs = {}}
local hitboxLoopRunning = false

local function createHitbox(parent, target)
    local part = Instance.new("Part")
    part.Name = "AshuHitbox"
    part.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
    part.CanCollide = false
    part.CanQuery = true
    part.CanTouch = false
    part.Massless = true
    part.Transparency = 1
    local weld = Instance.new("WeldConstraint")
    weld.Part0, weld.Part1 = target, part
    weld.Parent = part
    part.CFrame = target.CFrame
    part.Parent = parent
    return part, weld
end

local function destroyHitbox(data)
    if data and data.box then data.box:Destroy() end
end

local function hitboxLoop()
    if hitboxLoopRunning then return end
    hitboxLoopRunning = true
    task.spawn(function()
        while hitboxEnabled do
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local char = player.Character
                    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                    local hum  = char and char:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        local e = hitboxData.players[player]
                        if e and e.box and e.box.Parent then
                            e.box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                        else
                            local b, w = createHitbox(char, hrp)
                            hitboxData.players[player] = {box = b, weld = w}
                        end
                    elseif hitboxData.players[player] then
                        destroyHitbox(hitboxData.players[player])
                        hitboxData.players[player] = nil
                    end
                end
            end
            for _, desc in ipairs(workspace:GetDescendants()) do
                if desc.Name == "HumanoidRootPart" then
                    local parent = desc.Parent
                    if parent and parent:IsA("Model") and not Players:GetPlayerFromCharacter(parent) then
                        local hum = parent:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            local e = hitboxData.npcs[desc]
                            if e and e.box and e.box.Parent then
                                e.box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                            else
                                local b, w = createHitbox(parent, desc)
                                hitboxData.npcs[desc] = {box = b, weld = w}
                            end
                        elseif hitboxData.npcs[desc] then
                            destroyHitbox(hitboxData.npcs[desc])
                            hitboxData.npcs[desc] = nil
                        end
                    end
                end
            end
            task.wait(0.8)
        end
        for _, d in pairs(hitboxData.players) do destroyHitbox(d) end
        for _, d in pairs(hitboxData.npcs)    do destroyHitbox(d) end
        hitboxData.players, hitboxData.npcs = {}, {}
        hitboxLoopRunning = false
    end)
end

-- ============================================================
-- Avatar Stealer
-- ============================================================
local function stealAvatar(query)
    if not query or query == "" then return end
    local lower = string.lower(query)
    local found
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local n = string.lower(p.Name)
            local d = string.lower(p.DisplayName or "")
            if string.find(n, lower, 1, true) or string.find(d, lower, 1, true) then
                found = p; break
            end
        end
    end
    if not found or not found.Character then return end
    local hum = found.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local desc = hum:GetAppliedDescription()
    if not desc then return end

    local function splitList(s)
        local out = {}
        for m in string.gmatch(s, "[^,]+") do table.insert(out, m) end
        return out
    end
    local function hex(r, g, b)
        return string.format("%02X%02X%02X", r*255, g*255, b*255)
    end

    local acc = {}
    for _, slot in ipairs({"Back","Face","Front","Hair","Hat","Neck","Shoulders","Waist"}) do
        local val = desc[slot .. "Accessory"]
        if val and val ~= "" and val ~= 0 then
            if typeof(val) == "number" then
                acc[tostring(val)] = val
            else
                for _, part in ipairs(splitList(val)) do
                    local num = tonumber(part)
                    if num then acc[tostring(num)] = num end
                end
            end
        end
    end

    ReplicatedStorage:WaitForChild("AvatarRemotes"):WaitForChild("ApplyDescription"):FireServer({
        BodyParts = {
            RightArm = desc.RightArm, Head = desc.Head, RightLeg = desc.RightLeg,
            Torso = desc.Torso, LeftArm = desc.LeftArm, LeftLeg = desc.LeftLeg,
        },
        Shirt = desc.Shirt, Pants = desc.Pants, Face = desc.Face,
        Accessories = acc,
        BodyColors = {
            RightArm = hex(desc.RightArmColor.R, desc.RightArmColor.G, desc.RightArmColor.B),
            Head     = hex(desc.HeadColor.R,     desc.HeadColor.G,     desc.HeadColor.B),
            RightLeg = hex(desc.RightLegColor.R, desc.RightLegColor.G, desc.RightLegColor.B),
            Torso    = hex(desc.TorsoColor.R,    desc.TorsoColor.G,    desc.TorsoColor.B),
            LeftArm  = hex(desc.LeftArmColor.R,  desc.LeftArmColor.G,  desc.LeftArmColor.B),
            LeftLeg  = hex(desc.LeftLegColor.R,  desc.LeftLegColor.G,  desc.LeftLegColor.B),
        },
        TShirt = desc.GraphicTShirt,
    })
end

