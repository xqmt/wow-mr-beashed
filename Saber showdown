local function trackModel(model)
    if not model:IsA("Model") or model == LocalPlayer.Character then return end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.Died:Connect(function() processedModels[hum] = nil end)

    local animator = hum:FindFirstChildWhichIsA("Animator")
    if not animator or processedModels[animator] then return end
    processedModels[animator] = true

    animator.AnimationPlayed:Connect(function(track)
        local id = track.Animation.AnimationId:match("%d+$")
        local entry = id and animationDirections[tonumber(id)]
        if not entry then return end
        trackedAnimations[track] = {dirs = entry[1], model = model, executed = false}
    end)
end

RunService.Heartbeat:Connect(function()
    if not autoPBEnabled or not getMyHRP() then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            trackModel(player.Character)
        end
    end
    local folder = workspace:FindFirstChild("Characters")
    if folder then
        for _, m in ipairs(folder:GetChildren()) do trackModel(m) end
    end
end)

RunService.RenderStepped:Connect(function()
    if not autoPBEnabled then return end
    local hrp = getMyHRP()
    if not hrp then return end
    for track, data in pairs(trackedAnimations) do
        if track.IsPlaying then
            if not data.executed then
                local tHRP = data.model:FindFirstChild("HumanoidRootPart")
                if tHRP and (hrp.Position - tHRP.Position).Magnitude <= pbRange then
                    data.executed = true
                    for _, dir in ipairs(data.dirs) do
                        UpdateBlockDirection:FireServer(dir)
                    end
                end
            end
        else
            trackedAnimations[track] = nil
        end
    end
end)

