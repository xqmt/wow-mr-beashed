-- ============================================================
-- Keybind Handler
-- ============================================================
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    local key = input.KeyCode

    if key == keys.DamageKey then
        setDoubleDamage(not doubleDamageEnabled, true)
        Notify("2x Damage", doubleDamageEnabled and "Enabled" or "Disabled", 2)
        return
    end
    if key == keys.AutoPBKey then
        autoPBEnabled = not autoPBEnabled
        if not autoPBEnabled then trackedAnimations = {} end
        Notify("Auto PB", autoPBEnabled and "Enabled" or "Disabled", 2)
        return
    end
    if key == keys.AerialKey then doAerial() return end
    if key == keys.KataKey   then doKata()   return end
end)

