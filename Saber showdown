local pingGui, pingLabel = nil, nil
local pingEnabled        = false

local function ensurePingGui()
    if pingGui then return end
    pingGui = Instance.new("ScreenGui")
    pingGui.Name, pingGui.ResetOnSpawn = "AshuPing", false
    pingGui.Parent = (gethui and gethui()) or CoreGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 110, 0, 40)
    frame.Position = UDim2.new(0.82, 0, 0.15, 0)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = pingGui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

    pingLabel = Instance.new("TextLabel")
    pingLabel.Size = UDim2.new(1, 0, 1, 0)
    pingLabel.BackgroundTransparency = 1
    pingLabel.TextColor3 = Color3.new(1, 1, 1)
    pingLabel.Font = Enum.Font.GothamBold
    pingLabel.TextSize = 16
    pingLabel.Text = "Ping: 0 ms"
    pingLabel.Parent = frame

    task.spawn(function()
        while true do
            if pingEnabled then
                local p = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
                pingLabel.Text = "Ping: " .. p .. " ms"
                if p <= 70 then pingLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                elseif p <= 130 then pingLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
                else pingLabel.TextColor3 = Color3.fromRGB(255, 60, 60) end
            end
            task.wait(0.2)
        end
    end)
end

local function setPingEnabled(state)
    pingEnabled = state
    if state then
        ensurePingGui()
        pingGui.Enabled = true
    elseif pingGui then
        pingGui.Enabled = false
    end
end

