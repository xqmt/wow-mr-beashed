--// UTILITIES — MURDER KILL ALL (OnyxHub style)
--// ============================================================
local autoKillAllEnabled = false
local autoKillAllThread  = nil
local autoKillAllDelay   = 0.2

local function isMurderer()
    local character = localPlayer.Character
    if character and character:FindFirstChild("Knife") then return true end
    local bp = localPlayer:FindFirstChild("Backpack")
    if bp and bp:FindFirstChild("Knife") then return true end
    return false
end

local function getKnifeWithChar()
    local character = localPlayer.Character
    if not character then return nil end
    local knife = character:FindFirstChild("Knife")
    if knife then return knife, character end
    local bp = localPlayer:FindFirstChild("Backpack")
    bp = bp and bp:FindFirstChild("Knife")
    local hum = character:FindFirstChildOfClass("Humanoid")
    if bp and hum then
        hum:EquipTool(bp)
        task.wait(0.1)
        local c2 = localPlayer.Character
        return c2 and c2:FindFirstChild("Knife"), c2
    end
    return nil
end

local function getAllAliveTargets()
    local tbl = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                tbl[#tbl + 1] = player
            end
        end
    end
    return tbl
end

local function killAllPlayers()
    if not isMurderer() then return 0, "notmurderer" end
    local knife = getKnifeWithChar()
    if not knife then return 0, "noknife" end
    local events = knife:FindFirstChild("Events")
    if not events then return 0, "noevents" end
    local knifeStabbed  = events:FindFirstChild("KnifeStabbed")
    local handleTouched = events:FindFirstChild("HandleTouched")
    if not (knifeStabbed and handleTouched) then return 0, "noremote" end

    pcall(function() knifeStabbed:FireServer() end)

    local count = 0
    for _, player in ipairs(getAllAliveTargets()) do
        local pc = player.Character
        local target = pc and (
            pc:FindFirstChild("HumanoidRootPart")
            or pc:FindFirstChild("Torso")
            or pc:FindFirstChildWhichIsA("BasePart")
        )
        if target then
            pcall(function() handleTouched:FireServer(target) end)
            count += 1
        end
    end
    return count
end

local function killTargetByName(name)
    if not name or name == "" then return 0, "noname" end
    if not isMurderer() then return 0, "notmurderer" end
    local target = Players:FindFirstChild(name)
    if not target then return 0, "notfound" end
    local knife = getKnifeWithChar()
    if not knife then return 0, "noknife" end
    local events = knife:FindFirstChild("Events")
    if not events then return 0, "noevents" end
    local knifeStabbed  = events:FindFirstChild("KnifeStabbed")
    local handleTouched = events:FindFirstChild("HandleTouched")
    if not (knifeStabbed and handleTouched) then return 0, "noremote" end
    pcall(function() knifeStabbed:FireServer() end)
    local pc = target.Character
    local bodyPart = pc and (
        pc:FindFirstChild("HumanoidRootPart")
        or pc:FindFirstChild("Torso")
        or pc:FindFirstChildWhichIsA("BasePart")
    )
    if bodyPart then
        pcall(function() handleTouched:FireServer(bodyPart) end)
        return 1
    end
    return 0
end

local function startAutoKillAll()
    if autoKillAllThread then return end
    autoKillAllThread = task.spawn(function()
        while autoKillAllEnabled do
            task.wait(autoKillAllDelay)
            if isMurderer() then
                pcall(killAllPlayers)
            end
        end
    end)
end

local function stopAutoKillAll()
    if autoKillAllThread then
        pcall(task.cancel, autoKillAllThread)
        autoKillAllThread = nil
    end
end

--// ============================================================
--// UTILITIES — FLING (integrated with desync)
--// ============================================================
local flingInProgress = false

local function flingPlayer(target)
    if flingInProgress or not target then return end
    local character = localPlayer.Character; if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid"); if not humanoid then return end
    local rootPart = humanoid.RootPart; if not rootPart then return end

    local wasDesyncing = desyncEnabled
    if wasDesyncing then desyncPaused = true; task.wait(0.05) end

    local tChar = target.Character; if not tChar then return end
    local tHum = tChar:FindFirstChildOfClass("Humanoid")
    local tRoot = tHum and tHum.RootPart
    local head = tChar:FindFirstChild("Head")
    local acc = tChar:FindFirstChildOfClass("Accessory"); acc = acc and acc:FindFirstChild("Handle")

    if rootPart.Velocity.Magnitude < 50 then getgenv().RuzFlingOldPos = rootPart.CFrame end
    if tHum and tHum.Sit then
        if wasDesyncing then task.delay(0.3, function() desyncPaused = false end) end
        return
    end

    local camTarget = head or acc or tHum
    if camTarget then workspace.CurrentCamera.CameraSubject = camTarget end
    if not tChar:FindFirstChildWhichIsA("BasePart") then
        if wasDesyncing then task.delay(0.3, function() desyncPaused = false end) end
        return
    end

    local function setCF(part, offset, rot)
        local cf = CFrame.new(part.Position) * offset * rot
        rootPart.CFrame = cf
        pcall(function() character:SetPrimaryPartCFrame(cf) end)
        rootPart.Velocity = Vector3.new(9e7, 9e8, 9e7)
        rootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
    end

    local function doFling(targetPart)
        local endTime = tick() + 2.5
        local rot = 0
        while true do
            if rootPart and tHum then
                local vel = targetPart.Velocity.Magnitude
                if vel < 40 then
                    rot += 100
                    for _ = 1, 4 do
                        local md = tHum.MoveDirection * vel / 1.25
                        setCF(targetPart, CFrame.new(0, 1.5, 0) + md, CFrame.Angles(math.rad(rot), 0, 0))
                        task.wait()
                        setCF(targetPart, CFrame.new(0, -1.5, 0) + md, CFrame.Angles(math.rad(rot), 0, 0))
                        task.wait()
                    end
                else
                    local md = tHum.MoveDirection; local ws = tHum.WalkSpeed
                    setCF(targetPart, CFrame.new(md.X * ws * 0.12, 3, md.Z * ws * 0.12), CFrame.Angles(math.pi/2, 0, 0))
                    rootPart.Velocity = Vector3.new(9e8, 9e8, 9e8); task.wait()
                    setCF(targetPart, CFrame.new(-md.X * ws * 0.06, -3, -md.Z * ws * 0.06), CFrame.Angles(0, 0, 0))
                    rootPart.Velocity = Vector3.new(9e8, 9e8, 9e8); task.wait()
                end
                if not (endTime < tick()) then continue end
            end
            break
        end
    end

    flingInProgress = true
    workspace.FallenPartsDestroyHeight = (0/0)
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.zero; bv.MaxForce = Vector3.new(9e9, 9e9, 9e9); bv.Parent = rootPart
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    tRoot = tRoot or head or acc
    if tRoot then doFling(tRoot) end
    bv:Destroy()
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.CurrentCamera.CameraSubject = humanoid

    if getgenv().RuzFlingOldPos then
        for i = 1, 30 do
            rootPart.CFrame = getgenv().RuzFlingOldPos * CFrame.new(0, 0.5, 0)
            pcall(function() character:SetPrimaryPartCFrame(getgenv().RuzFlingOldPos * CFrame.new(0, 0.5, 0)) end)
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            for _, c in ipairs(character:GetChildren()) do
                if c:IsA("BasePart") then c.Velocity = Vector3.new(); c.RotVelocity = Vector3.new() end
            end
            task.wait()
            if i > 30 or (rootPart.Position - getgenv().RuzFlingOldPos.p).Magnitude < 25 then break end
        end
    end
    flingInProgress = false
    if wasDesyncing then task.delay(0.5, function() desyncPaused = false end) end
end

local function flingWeaponHolder(weaponName)
    if flingInProgress then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer then
            local c = p.Character
            local bp = p:FindFirstChild("Backpack")
            if (c and c:FindFirstChild(weaponName)) or (bp and bp:FindFirstChild(weaponName)) then
                task.spawn(flingPlayer, p); return
            end
        end
    end
end

--// ============================================================
--// UTILITIES — ANTI FLING (self-protection)
--// ============================================================
local antiFlingEnabled    = false
local antiFlingConn       = nil
local antiFlingSitConn    = nil
local antiFlingGraceUntil = 0

local function antiFlingResetPart(part)
    if not part or not part.Parent then return end
    local lv = part.AssemblyLinearVelocity
    local av = part.AssemblyAngularVelocity
    if lv.Magnitude > 200 then
        part.AssemblyLinearVelocity = Vector3.zero
        part.Velocity = Vector3.zero
    end
    if av.Magnitude > 50 then
        part.AssemblyAngularVelocity = Vector3.zero
        part.RotVelocity = Vector3.zero
    end
end

local function antiFlingStripMovers(hrp)
    for _, c in ipairs(hrp:GetChildren()) do
        if c:IsA("BodyVelocity") or c:IsA("BodyGyro") or c:IsA("BodyAngularVelocity")
        or c:IsA("LinearVelocity") or c:IsA("AngularVelocity")
        or c:IsA("VectorForce") or c:IsA("Torque") then
            pcall(function() c:Destroy() end)
        end
    end
end

local function antiFlingBindHum()
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and antiFlingEnabled then
        pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end)
    end
end

local function startAntiFling()
    if antiFlingConn then return end
    antiFlingGraceUntil = tick() + 1

    antiFlingConn = RunService.Stepped:Connect(function()
        if not antiFlingEnabled then return end
        if tick() < antiFlingGraceUntil then return end
        -- Don't fight the intentional desync void teleport
        if desyncEnabled and (desyncPaused or desyncBusy) then return end

        local char = localPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        -- Strip injected movers on HRP
        antiFlingStripMovers(hrp)

        -- Reset seated state (common fling setup)
        if hum.Sit then
            hum.Sit = false
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end

        -- Reset velocity on every body part + accessory handles
        for _, p in ipairs(char:GetChildren()) do
            if p:IsA("BasePart") then
                antiFlingResetPart(p)
            elseif p:IsA("Accessory") then
                local h = p:FindFirstChild("Handle")
                if h then antiFlingResetPart(h) end
            end
        end
    end)

    antiFlingSitConn = localPlayer.CharacterAdded:Connect(function()
        task.wait(0.5); antiFlingBindHum()
    end)
    antiFlingBindHum()
end

local function stopAntiFling()
    if antiFlingConn then
        antiFlingConn:Disconnect()
        antiFlingConn = nil
    end
    if antiFlingSitConn then
        antiFlingSitConn:Disconnect()
        antiFlingSitConn = nil
    end
end

localPlayer.CharacterAdded:Connect(function()
    antiFlingGraceUntil = tick() + 2
end)

