local function hasGunOrRevolver(p)
    if not p then return false end
    local c = p.Character
    if c and (c:FindFirstChild("Gun") or c:FindFirstChild("Revolver")) then return true end
    local bp = p:FindFirstChild("Backpack")
    if bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver")) then return true end
    return false
end

-- Check workspace direct children first (GunDrop is usually top-level)
local function findGunDrop()
    for _, d in ipairs(workspace:GetChildren()) do
        if d.Name == "GunDrop" then return d end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d.Name == "GunDrop" and d.Parent then return d end
    end
    return nil
end

-- Limit drop parts to a handful — usually just one or two matter
local function collectDropTouchParts(gd)
    local parts = {}
    if gd:IsA("BasePart") then
        parts[#parts+1] = gd
    end
    for _, d in ipairs(gd:GetDescendants()) do
        if d:IsA("BasePart") then
            parts[#parts+1] = d
        end
        if #parts >= 5 then break end
    end
    return parts
end

-- ONLY use the key body parts (HRP + torso + head) — cuts firetouchinterest calls by ~5x
local function collectKeyParts(character)
    local parts = {}
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then parts[#parts+1] = hrp end
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if torso then parts[#parts+1] = torso end
    local head = character:FindFirstChild("Head")
    if head then parts[#parts+1] = head end
    if #parts == 0 then
        for _, c in ipairs(character:GetChildren()) do
            if c:IsA("BasePart") then
                parts[#parts+1] = c
                if #parts >= 3 then break end
            end
        end
    end
    return parts
end

-- 6 reps (was 20) and only key parts — ~10-15x fewer firetouchinterest calls
local function grabGunFast(gd)
    if not gd or not gd.Parent then return false, "nodrop" end
    local character = localPlayer.Character
    if not character then return false, "nochar" end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "nochar" end

    local parts = collectDropTouchParts(gd)
    if #parts == 0 then return false, "notouch" end
    local myParts = collectKeyParts(character)

    local wasDesyncing = desyncEnabled and not desyncPaused
    if wasDesyncing then desyncPaused = true end

    local success = false
    local ok = pcall(function()
        for rep = 1, 6 do
            for i = 1, #myParts do
                local myPart = myParts[i]
                for j = 1, #parts do
                    local part = parts[j]
                    pcall(firetouchinterest, myPart, part, 0)
                    pcall(firetouchinterest, myPart, part, 1)
                end
            end
            if hasGunOrRevolver(localPlayer) then success = true; return end
            if not gd.Parent then return end
            if rep % 2 == 0 then task.wait() end
        end
    end)

    if wasDesyncing then desyncPaused = false end

    if success or hasGunOrRevolver(localPlayer) then return true end
    if not ok then return false, "error" end
    return false, "refused"
end

local function stopGrabGunHammer()
    if grabGunHammerThread then
        pcall(task.cancel, grabGunHammerThread)
        grabGunHammerThread = nil
    end
end

local function startGrabGunHammer(gd)
    if not gd or not gd.Parent then return end
    -- Don't restart if already hammering the same drop
    if grabGunHammerThread and grabGunKnownDrop == gd then return end
    stopGrabGunHammer()
    grabGunHammerThread = task.spawn(function()
        while autoGrabGunEnabled and gd.Parent and not hasGunOrRevolver(localPlayer) do
            grabGunFast(gd)
            task.wait(0.1)   -- 10x/sec instead of every frame
        end
    end)
end

local function startGrabGunWatcher()
    if grabGunThread then return end
    grabGunGraceUntil = tick() + 1.5

    -- Only do the expensive check for GunDrop-related descendants
    grabGunSpawnConn = workspace.DescendantAdded:Connect(function(d)
        if not autoGrabGunEnabled then return end
        local isDrop = d.Name == "GunDrop"
        local inDrop = d.Parent and d.Parent.Name == "GunDrop"
        if not (isDrop or inDrop) then return end
        if hasGunOrRevolver(localPlayer) then return end
        local drop = isDrop and d or d.Parent
        grabGunKnownDrop = drop
        task.defer(function() startGrabGunHammer(drop) end)
    end)

    -- Slow backup poller — only scans when nothing is tracked
    grabGunThread = task.spawn(function()
        while autoGrabGunEnabled do
            task.wait(0.5)   -- was 0.02 → now 0.5
            if tick() <= grabGunGraceUntil then continue end
            if hasGunOrRevolver(localPlayer) then
                stopGrabGunHammer()
                grabGunKnownDrop = nil
                continue
            end
            if grabGunKnownDrop and grabGunKnownDrop.Parent then continue end
            local gd = findGunDrop()
            if gd then
                grabGunKnownDrop = gd
                startGrabGunHammer(gd)
            else
                grabGunKnownDrop = nil
            end
        end
        stopGrabGunHammer()
        grabGunKnownDrop = nil
    end)
end

local function stopGrabGunWatcher()
    if grabGunThread then
        pcall(task.cancel, grabGunThread)
        grabGunThread = nil
    end
    if grabGunSpawnConn then
        grabGunSpawnConn:Disconnect()
        grabGunSpawnConn = nil
    end
    stopGrabGunHammer()
    grabGunKnownDrop = nil
end

local function tryGrabGunNow()
    local gd = findGunDrop()
