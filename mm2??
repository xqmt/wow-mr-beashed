--// ============================================================
--// UTILITIES — DESYNC VOID (must come BEFORE grab / kill so they can pause it)
--// ============================================================
local desyncEnabled    = false
local desyncConnection = nil
local desyncPaused     = false
local desyncBusy       = false
local desyncHeight     = -15000
local desyncRange      = 0
local desyncKeybind    = Enum.KeyCode.G

local function desyncSetEnabled(value)
    desyncEnabled = value
    if value then
        if desyncConnection then return end
        desyncConnection = RunService.Heartbeat:Connect(function()
            if not desyncEnabled or desyncPaused or desyncBusy then return end
            local char = localPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if not hrp or not hum then return end

            desyncBusy = true
            local origCF     = hrp.CFrame
            local origOffset = hum.CameraOffset

            local rx = desyncRange > 0 and math.random(-desyncRange, desyncRange) or 0
            local rz = desyncRange > 0 and math.random(-desyncRange, desyncRange) or 0
            local voidCF = origCF * CFrame.new(rx, desyncHeight, rz)
            local offsetPos = voidCF:ToObjectSpace(CFrame.new(origCF.Position)).Position

            hrp.CFrame       = voidCF
            hum.CameraOffset = offsetPos
            RunService.RenderStepped:Wait()
            hrp.CFrame       = origCF
            hum.CameraOffset = origOffset
            desyncBusy = false
        end)
    else
        if desyncConnection then
            desyncConnection:Disconnect()
            desyncConnection = nil
        end
        desyncBusy = false
    end
end

