local espEnabled   = false
local espMurderer  = true
local espSheriff   = true
local espInnocent  = true
local espSelf      = false
local lastRoleCheck = 0
local cachedMurdererName, cachedSheriffName, cachedHeroName
local roleData    = {}
local roleRemote  = nil

local espColors = {
    murderer = Color3.fromRGB(220, 30, 30), sheriff = Color3.fromRGB(30, 80, 220),
    hero     = Color3.fromRGB(255, 220, 0), innocent = Color3.fromRGB(30, 200, 30),
    self     = Color3.fromRGB(220, 220, 220),
}

local function applyHighlight(character, color)
    if not character:FindFirstChildWhichIsA("Humanoid") then return end
    local hl = character:FindFirstChild("RuzHL")
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "RuzHL"; hl.Adornee = character
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
        hl.Parent = character
        hl.AncestryChanged:Connect(function()
            if hl.Parent and not character.Parent then hl:Destroy() end
        end)
    end
    hl.FillColor = color; hl.OutlineColor = color
end

local function removeHighlight(character)
    local hl = character:FindFirstChild("RuzHL"); if hl then hl:Destroy() end
end

local function clearAllHighlights()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then removeHighlight(p.Character) end
    end
end

local function detectRole(player)
    local role = "Innocent"
    local data = roleData[player.Name]
    if data then
        local r = tostring(data.Role or data.role or data.Team or data.RoleSelect or ""):lower()
        if r:find("murd") or r:find("killer") then role = "Murderer"
        elseif r:find("sheriff") or r:find("gun") then role = "Sheriff"
        elseif r:find("hero") then role = "Hero" end
    end
    if role == "Innocent" then
        local attr = player:GetAttribute("Role") or player:GetAttribute("RoleSelect") or player:GetAttribute("Team")
        if attr then
            local r = tostring(attr):lower()
            if r:find("murd") or r:find("killer") then role = "Murderer"
            elseif r:find("sheriff") then role = "Sheriff"
            elseif r:find("hero") then role = "Hero" end
        end
    end
    if role == "Innocent" then
        local c = player.Character
        if c then
            if c:FindFirstChild("Knife") or c:FindFirstChild("Blade") then role = "Murderer"
            elseif c:FindFirstChild("Gun") or c:FindFirstChild("Revolver") then role = "Sheriff" end
        end
        local bp = player:FindFirstChild("Backpack")
        if bp and (bp:FindFirstChild("Knife") or bp:FindFirstChild("Blade")) then role = "Murderer" end
    end
    return role
end

local function findRoleRemote()
    for _, name in ipairs({"GetCurrentPlayerData","GetPlayerData","PlayerData","GetRoles","RoleData"}) do
        local r = ReplicatedStorage:FindFirstChild(name, true)
        if r and (r:IsA("RemoteFunction") or r:IsA("RemoteEvent")) then return r end
    end
end

local function refreshRoleData()
    if not roleRemote then roleRemote = findRoleRemote() end
    if not roleRemote then return end
    local ok, res = pcall(function()
        if roleRemote:IsA("RemoteFunction") then return roleRemote:InvokeServer() end
    end)
    if ok and type(res) == "table" then roleData = res end
end

local function espTick()
    if tick() - lastRoleCheck > 1 then
        refreshRoleData(); lastRoleCheck = tick()
        cachedMurdererName, cachedSheriffName, cachedHeroName = nil, nil, nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer then
                local role = detectRole(p)
                if role == "Murderer" then cachedMurdererName = p.Name
                elseif role == "Sheriff" then cachedSheriffName = p.Name
                elseif role == "Hero" then cachedHeroName = p.Name end
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            if char then removeHighlight(char) end
        else
            local hum = char:FindFirstChild("Humanoid")
            if not hum or hum.Health <= 0 then removeHighlight(char)
            else
                local isSelf     = p == localPlayer
                local isMurderer = p.Name == cachedMurdererName
                local isHero     = p.Name == cachedHeroName
                local isSheriff  = p.Name == cachedSheriffName
                local isInnocent = not (isMurderer or isHero or isSheriff or isSelf)
                local show = (isSelf and espSelf) or (isMurderer and espMurderer)
                          or (isSheriff and espSheriff) or (isHero and espSheriff)
                          or (isInnocent and espInnocent)
                if show then
                    local color
                    if isMurderer then color = espColors.murderer
                    elseif isHero then color = espColors.hero
                    elseif isSheriff then color = espColors.sheriff
                    elseif isSelf then color = espColors.self
                    else color = espColors.innocent end
                    applyHighlight(char, color)
                else removeHighlight(char) end
            end
        end
    end
end

local espConnection = nil
local function startESP()
    if espConnection then return end
    local acc = 0
    espConnection = RunService.Heartbeat:Connect(function(dt)
        acc = acc + dt; if acc < 0.05 then return end
        acc = 0; espTick()
    end)
end

local function stopESP()
    if espConnection then espConnection:Disconnect(); espConnection = nil end
    clearAllHighlights()
end

pcall(function()
    local gameplay = ReplicatedStorage:WaitForChild("Remotes", 10):WaitForChild("Gameplay", 10)
    if gameplay then
        if gameplay:FindFirstChild("RoleSelect") then
            gameplay.RoleSelect.OnClientEvent:Connect(function() if espEnabled then lastRoleCheck = 0 end end)
        end
        if gameplay:FindFirstChild("PlayerDataChanged") then
            gameplay.PlayerDataChanged.OnClientEvent:Connect(function() if espEnabled then lastRoleCheck = 0 end end)
        end
    end
end)

