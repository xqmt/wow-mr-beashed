local function predictPosition(player, prediction)
    local character = player.Character; if not character then return Vector3.zero end
    local root = character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart")
    local hum  = character:FindFirstChild("Humanoid")
    if not root or not hum then return Vector3.zero end
    return root.Position
        + root.AssemblyLinearVelocity * Vector3.new(0.75, 0.5, 0.75) * prediction / 15
        + hum.MoveDirection * prediction
end

local function shootFromRightHand(target)
    if not localPlayer.Character then return end
    local gun = localPlayer.Character:FindFirstChild("Gun"); if not gun then return end
    local char = target.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local predicted = predictPosition(target, 2.8)
    local rightHand = localPlayer.Character:FindFirstChild("RightHand"); if not rightHand then return end
    local shoot = gun:FindFirstChild("Shoot"); if not shoot then return end
    pcall(function() shoot:FireServer(CFrame.new(rightHand.Position), CFrame.new(predicted)) end)
end

local function wallbangShoot(target)
    if not localPlayer.Character then return end
    local gun = localPlayer.Character:FindFirstChild("Gun"); if not gun then return end
    local char = target.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local predicted = predictPosition(target, 2.8)
    local shoot = gun:FindFirstChild("Shoot"); if not shoot then return end
    pcall(function() shoot:FireServer(CFrame.new(hrp.Position), CFrame.new(predicted)) end)
end

local function flickCamera()
    local char = localPlayer.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
        local base = hrp.CFrame
        local target = base * CFrame.Angles(0, math.pi, 0)
        for i = 1, 4 do hrp.CFrame = base:Lerp(target, i / 4); RunService.RenderStepped:Wait() end
    else
        local cam = workspace.CurrentCamera.CFrame
        local lv  = cam.LookVector
        local target = CFrame.lookAt(cam.Position, cam.Position + Vector3.new(-lv.X, lv.Y, -lv.Z))
        for i = 1, 5 do workspace.CurrentCamera.CFrame = cam:Lerp(target, i / 5); RunService.RenderStepped:Wait() end
    end
end

local function getWeaponType(player)
    if not player then return nil end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        if bp:FindFirstChild("Knife") then return "Knife" end
        if bp:FindFirstChild("Gun") then return "Gun" end
    end
    local c = player.Character
    if c then
        if c:FindFirstChild("Knife") then return "Knife" end
        if c:FindFirstChild("Gun") then return "Gun" end
    end
    return nil
end

local function findNearestWeaponHolder()
    local holders = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local w = getWeaponType(p)
            if w then table.insert(holders, { player = p, weapon = w }) end
        end
    end
    if #holders == 0 then return nil end
    local weapons = {}
    for _, h in ipairs(holders) do weapons[h.weapon] = true end
    local count = 0; for _ in pairs(weapons) do count = count + 1 end
    if count == 1 then
        local myHRP = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        local best, bestD = nil, math.huge
        for _, h in ipairs(holders) do
            if myHRP then
                local d = (myHRP.Position - h.player.Character.HumanoidRootPart.Position).Magnitude
                if d < bestD then best, bestD = h.player, d end
            else
                best = best or h.player
            end
        end
        return best
    end
    local cam = workspace.CurrentCamera
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local best, bestD = nil, math.huge
    for _, h in ipairs(holders) do
        local pos, onScreen = cam:WorldToViewportPoint(h.player.Character.HumanoidRootPart.Position)
        if onScreen then
            local d = (center - Vector2.new(pos.X, pos.Y)).Magnitude
            if d < bestD then best, bestD = h.player, d end
        end
    end
    return best or holders[1].player
end

local function findKnifeHolder()
    for _, p in ipairs(Players:GetPlayers()) do
        local bp = p:FindFirstChild("Backpack")
        if bp and bp:FindFirstChild("Knife") then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("Knife") then return p end
    end
    return nil
end

local function findGunHolder()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer then
            local bp = p:FindFirstChild("Backpack")
            if bp and bp:FindFirstChild("Gun") then return p end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character and p.Character:FindFirstChild("Gun") then return p end
    end
    return nil
end

local function findNearestPlayer()
    if not localPlayer.Character then return nil end
    local myHRP = localPlayer.Character:FindFirstChild("HumanoidRootPart"); if not myHRP then return nil end
    local best, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (myHRP.Position - hrp.Position).Magnitude
                if d < bestD then best, bestD = p, d end
            end
        end
    end
    return best
end

local function selectTarget()
    if murdererCache and murdererCache.Character and murdererCache.Character:FindFirstChild("HumanoidRootPart") then
        return murdererCache
    end
    if sheriffCache and sheriffCache.Character and sheriffCache.Character:FindFirstChild("HumanoidRootPart") then
        return sheriffCache
    end
    local wh = findNearestWeaponHolder(); if wh then return wh end
    local kh = findKnifeHolder(); if kh and kh ~= localPlayer then return kh end
    local gh = findGunHolder(); if gh and gh ~= localPlayer then return gh end
    return findNearestPlayer()
end

local function isInFOV(target)
    if silentAimIgnoreFov then return true end
    if not fovConfig.Visible then return true end
    if not target.Character then return false end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart"); if not hrp then return false end
    local cam = workspace.CurrentCamera
    local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
    if not onScreen then return false end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    return (center - Vector2.new(pos.X, pos.Y)).Magnitude <= fovConfig.Radius
end

local function doSilentShoot()
    if not localPlayer.Character then return end
    if not localPlayer.Character:FindFirstChild("Gun") then
        local gun = localPlayer.Backpack:FindFirstChild("Gun")
        if gun then
            local hum = localPlayer.Character:FindFirstChild("Humanoid")
            if hum then hum:EquipTool(gun); task.wait(0.1) end
        end
        if not localPlayer.Character:FindFirstChild("Gun") then return end
    end
    local target = selectTarget()
    if not target or not isInFOV(target) then return end
    if silentAimMethod == "Wallbang" then
        wallbangShoot(target); watchForKill(target)
    elseif silentAimMethod == "Flick" then
        if flickInProgress then return end
        flickInProgress = true
        task.spawn(function()
            flickCamera(); task.wait(0.12)
            shootFromRightHand(target); watchForKill(target)
            task.wait(0.88); flickInProgress = false
        end)
    else
        shootFromRightHand(target); watchForKill(target)
    end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp or not silentAimEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        doSilentShoot()
    elseif input.UserInputType == Enum.UserInputType.Touch then
        touchStart[input] = input.Position; touchMoved[input] = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not touchStart[input] then return end
    local d = input.Position - touchStart[input]
    if touchThreshold <= math.abs(d.X) + math.abs(d.Y) then touchMoved[input] = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not touchStart[input] then return end
    local moved = touchMoved[input]
    touchStart[input] = nil; touchMoved[input] = nil
    if not silentAimEnabled or moved then return end
    doSilentShoot()
end)

if hookmetamethod and getnamecallmethod and checkcaller then
    local oldNamecall
    pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if not silentAimEnabled or checkcaller() or method ~= "FireServer" or self.Name ~= "Shoot" then
                return oldNamecall(self, ...)
            end
            local target = selectTarget()
            if not target or not isInFOV(target) then return oldNamecall(self, ...) end
            local tChar = target.Character
            local tHRP  = tChar and tChar:FindFirstChild("HumanoidRootPart")
            if not tHRP then return oldNamecall(self, ...) end
            local predicted = predictPosition(target, 2.8)
            local myChar    = localPlayer.Character
            local rightHand = myChar and myChar:FindFirstChild("RightHand")
            if not rightHand then return oldNamecall(self, ...) end
            if silentAimMethod == "Wallbang" then
                local r = oldNamecall(self, CFrame.new(tHRP.Position), CFrame.new(predicted))
                watchForKill(target); return r
            end
            if silentAimMethod == "Flick" then
                if flickInProgress then return end
                flickInProgress = true
                local orig = self
                task.delay(0, function()
                    flickCamera(); task.wait(0.1)
                    pcall(function() oldNamecall(orig, CFrame.new(rightHand.Position), CFrame.new(predicted)) end)
                    watchForKill(target); task.wait(0.9); flickInProgress = false
                end)
                return
            end
            local r = oldNamecall(self, CFrame.new(rightHand.Position), CFrame.new(predicted))
            watchForKill(target); return r
        end)
    end)
end

