local function playHitSound(force)
    if not force and not hitSoundsEnabled then return end
    if not hitSoundId or hitSoundId == "None" then return end
    hitSound.SoundId = hitSoundId; hitSound.Volume = hitSoundVolume
    hitSound.TimePosition = 0; hitSound:Play()
end

local function showHitOverlay(force)
    if not force and not hitOverlayEnabled then return end
    if not hitOverlayImageId or hitOverlayImageId == "" then return end
    local img = Instance.new("ImageLabel")
    img.AnchorPoint = Vector2.new(0.5, 0.5); img.Position = UDim2.fromScale(0.5, 0.5)
    img.Size = UDim2.fromScale(1, 1); img.BackgroundTransparency = 1
    img.Image = hitOverlayImageId; img.ImageColor3 = hitOverlayColor
    img.ImageTransparency = 1; img.ZIndex = 999999; img.Parent = hitOverlayGui

    local total   = math.max(0.12, hitOverlayLifetime)
    local fadeIn  = total * 0.20
    local hold    = total * 0.15
    local fadeOut = total * 0.65

    local tweenIn = TweenService:Create(img,
        TweenInfo.new(fadeIn, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { ImageTransparency = 0 })
    tweenIn:Play()
    tweenIn.Completed:Connect(function()
        task.delay(hold, function()
            if not img or not img.Parent then return end
            local tweenOut = TweenService:Create(img,
                TweenInfo.new(fadeOut, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { ImageTransparency = 1 })
            tweenOut:Play()
            tweenOut.Completed:Connect(function()
                if img and img.Parent then img:Destroy() end
            end)
        end)
    end)
end

local function onHit() playHitSound(); showHitOverlay() end

local pendingKills = {}
local function watchForKill(target)
    if not target or target == localPlayer then return end
    local char = target.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local userId = target.UserId
    if pendingKills[userId] then pendingKills[userId].lastShot = tick(); return end
    local entry = { lastShot = tick(), conn = nil, finished = false }
    pendingKills[userId] = entry
    local function finish(triggered)
        if entry.finished then return end
        entry.finished = true
        if entry.conn then entry.conn:Disconnect() end
        if pendingKills[userId] == entry then pendingKills[userId] = nil end
        if triggered then onHit() end
    end
    entry.conn = hum.Died:Connect(function() finish(true) end)
    task.spawn(function()
        while not entry.finished do
            task.wait(0.1)
            if tick() - entry.lastShot > 2 then finish(false) end
        end
    end)
end

