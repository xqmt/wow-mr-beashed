local function isReloadSound(name)
    local n = name:lower(); return n:find("reload") or n:find("reloading") or n:find("mag") ~= nil
end
local function isShootSound(sound)
    if isReloadSound(sound.Name) then return false end
    local n = sound.Name:lower(); local sid = (sound.SoundId or ""):lower()
    for _, key in ipairs({ "shoot","shot","gunshot","fire","gun","muzzle" }) do
        if n:find(key) or sid:find(key) then return true end
    end
    return false
end

local function shootSndRestore()
    for k, v in pairs(shootSndSaved) do
        if k and k.Parent then
            pcall(function()
                k.SoundId = v.id; k.Volume = v.volume; k.PlaybackSpeed = v.pitch
            end)
        end
    end
    shootSndSaved = {}
    if shootSndConn then shootSndConn:Disconnect(); shootSndConn = nil end
end

local function shootSndPatch(sound)
    if shootSndSaved[sound] then return end
    local id = ShootSndMap[shootSndPreset]; if not id then return end
    shootSndSaved[sound] = { id = sound.SoundId, volume = sound.Volume, pitch = sound.PlaybackSpeed }
    pcall(function() sound.SoundId = id; sound.Volume = 1; sound.PlaybackSpeed = 1 end)
end

local function shootSndStart()
    shootSndRestore()
    if not shootSndEnabled or shootSndPreset == "None" then return end
    local function scan(root)
        if not root then return end
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("Sound") and isShootSound(d) then shootSndPatch(d) end
        end
    end
    scan(workspace); scan(localPlayer.Character); scan(localPlayer.PlayerGui); scan(SoundService)
    shootSndConn = workspace.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") and shootSndEnabled and isShootSound(d) then
            task.defer(function() shootSndPatch(d) end)
        end
    end)
end

localPlayer.CharacterAdded:Connect(function()
    task.wait(0.8)
    if shootSndEnabled then task.spawn(shootSndStart) end
end)

