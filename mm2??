local auraEnabled = false
local auraType    = "None"
local auraColor   = Color3.fromRGB(133, 220, 255)
local auraParts   = {}
local auraCache   = {}

local AuraPresets = {
    { name="Angel Wings", id="97658130917593" }, { name="Starlight", id="134645216613107" },
    { name="Heavenly", id="139300897520961" }, { name="Ribbon", id="132069507632161" },
    { name="Sakura", id="81755778619404" }, { name="Wind", id="80694081850877" },
    { name="Flow", id="119913533725648" }, { name="Star", id="73754563740680" },
}
local AuraNames = { "None" }; local AuraMap = {}
for _, p in ipairs(AuraPresets) do table.insert(AuraNames, p.name); AuraMap[p.name] = p.id end

local function auraApplyColor(inst, color)
    if not inst or not color then return end
    local cs = ColorSequence.new(color)
    local function proc(obj)
        if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") then
            pcall(function() obj.Color = cs end)
        elseif obj:IsA("PointLight") then pcall(function() obj.Color = color end) end
    end
    proc(inst)
    for _, d in ipairs(inst:GetDescendants()) do proc(d) end
end

local function auraClear()
    for _, p in ipairs(auraParts) do
        if p and p.Parent then pcall(function() p:Destroy() end) end
    end
    auraParts = {}
end

local function auraSpawn()
    auraClear()
    if not auraEnabled or auraType == "None" then return end
    local id = AuraMap[auraType]; if not id then return end
    local character = localPlayer.Character; if not character then return end
    local src = auraCache[auraType]
    if not src then
        local ok
        ok, src = pcall(function() return game:GetObjects("rbxassetid://" .. id)[1] end)
        if not ok or not src then return end
        auraCache[auraType] = src
    end
    local partMap = {}
    for _, c in ipairs(character:GetChildren()) do
        if c:IsA("BasePart") then partMap[c.Name] = c end
    end
    local clone = src:Clone()
    for _, c in ipairs(clone:GetChildren()) do
        local target = partMap[c.Name]
        if target then
            for _, fx in ipairs(c:GetChildren()) do
                local fxClone = fx:Clone()
                fxClone.Name = "RuzAuraFX"; fxClone.Parent = target
                auraApplyColor(fxClone, auraColor)
                if fxClone:IsA("ParticleEmitter") then fxClone.Enabled = true end
                for _, d in ipairs(fxClone:GetDescendants()) do
                    if d:IsA("ParticleEmitter") then d.Enabled = true end
                end
                table.insert(auraParts, fxClone)
            end
        end
    end
    clone:Destroy()
end

local function auraRefreshColor()
    for _, p in ipairs(auraParts) do
        if p and p.Parent then auraApplyColor(p, auraColor) end
    end
end

