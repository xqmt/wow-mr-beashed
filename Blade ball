-- PARRY, CURVE, TRIGGERBOT & SPAM
-- ═══════════════════════════════════════════════════════════
local triggerbotState = {
    on = false,
    busy = false,
    key = Enum.KeyCode[config.triggerbot_key] or Enum.KeyCode.T,
}

local parryState = {
    debounce = false,
    until_at = 0,
    accuracy = (config.accuracy - 1) * 0.015151515151515152,
}

local function computeParryRadius(ball, parryAccuracy)
    local pingClamp = clampValue(dataPing:GetValue() / 10 / 10, 5, 17)
    local speed = 0
    if ball then
        local zoomies = ball:FindFirstChild("zoomies")
        if zoomies and typeof(zoomies.VectorVelocity) == "Vector3" then
            speed = zoomies.VectorVelocity.Magnitude
        elseif typeof(ball.AssemblyLinearVelocity) == "Vector3" then
            speed = ball.AssemblyLinearVelocity.Magnitude
        end
    end
    local acc = tonumber(parryAccuracy) or parryState.accuracy
    local divisor = (2.4 + minValue(maxValue(speed - 9.5, 0), 650) * 0.002) * acc
    local dynamicPart = divisor ~= 0 and maxValue(speed / divisor, 9.5) or 9.5
    return pingClamp + dynamicPart
end

ballState.curved = function(ball)
    local b = ball or ballState.get()
    if not b then return false end
    local zoomies = b:FindFirstChild("zoomies")
    if not zoomies then return false end

    local now = tick()
    local ping = dataPing:GetValue()
    local vel = zoomies.VectorVelocity
    local unit = vel.Unit
    local char = localPlayer.Character
    local root = char and char.PrimaryPart
    if not root then return false end
    local pos = root.Position
    local bPos = ballState.position(b)
    local toPlayerUnit = (pos - bPos).Unit
    local dot = toPlayerUnit:Dot(unit)
    local speed = vel.Magnitude
    if speed == 0 then return false end
    local speedFactor = minValue(speed / 100, 40)
    local curveDelta = dot - toPlayerUnit:Dot((unit - vel).Unit)
    local dist = (pos - bPos).Magnitude
    local threshold = 0.5 - ping / 1000
    local timeToArrive = dist / speed - ping / 1000
    local safeRadius = 15 - minValue(dist / 1000, 15) + speedFactor

    ballState.state.LerpRadians = lerpValue(ballState.state.LerpRadians, toRadians(arcSin(clampValue(dot, -1, 1))), 0.8)
    if speed > 100 and timeToArrive > ping / 10 then
        safeRadius = maxValue(safeRadius - 15, 15)
    end
    if dist < safeRadius then return false end
    if curveDelta < threshold then return true end
    if ballState.state.LerpRadians < 0.018 then
        ballState.state.LastWarping = now
    end
    if now - ballState.state.LastWarping < timeToArrive / 1.5 then return true end
    if now - ballState.state.Curving < timeToArrive / 1.5 then return true end
    return dot < threshold
end

ballState.bind = function(b)
    spawnTask(function()
        if not b:GetAttribute("realBall") and not b:WaitForChild("zoomies", 3) then
            return
        end
        b:GetAttributeChangedSignal("target"):Connect(function()
            parryState.debounce = false
            parryState.until_at = 0
            if config.random_target then
                targetManager.pick_random()
            end
        end)
    end)
end

balls.ChildAdded:Connect(function(b)
    parryState.debounce = false
    parryState.until_at = 0
    if config.random_target then
        targetManager.pick_random()
    end
    ballState.bind(b)
end)

for _, b in ipairs(balls:GetChildren()) do
    ballState.bind(b)
end

balls.ChildRemoved:Connect(function(child)
    ballState.positions[child] = nil
    parryController.count = 0
    parryState.debounce = false
    parryState.until_at = 0
    targetManager.current = nil
    targetManager.visited = {}
    if runtimeConnections.target_change then
        runtimeConnections.target_change:Disconnect()
        runtimeConnections.target_change = nil
    end
end)

parryState.check = function()
    if not config.auto_parry or not _G.oxymod or triggerbotState.busy then return end
    local char = localPlayer.Character
    local root = char and char.PrimaryPart
    if not root then return end

    local now = tick()
    if parryState.debounce or now < parryState.until_at then return end

    local pos = root.Position
    local mainBall = ballState.get()
    local mainTarget = mainBall and mainBall:GetAttribute("target")
    local tornado = runtime:FindFirstChild("Tornado")
    local tornadoTime = tornado and (tornado:GetAttribute("TornadoTime") or 1)

    for _, b in ipairs(ballState.get_all()) do
        if b and b.Parent then
            local zoomies = b:FindFirstChild("zoomies")
            if zoomies then
                local bTarget = b:GetAttribute("target")
                local speed = zoomies.VectorVelocity.Magnitude
                local dist = (pos - ballState.position(b)).Magnitude
                local reach = computeParryRadius(b, parryState.accuracy)

                if b:FindFirstChild("AeroDynamicSlashVFX") then
                    Debris:AddItem(b.AeroDynamicSlashVFX, 0)
                    ballState.state.AerodynamicTime = now
                end

                local skipBall = false
                if config.infinity_detection and detectionState.infinity_active then
                    skipBall = true
                elseif config.death_slash_detection and detectionState.death_slash_active then
                    skipBall = true
                elseif config.anti_phantom and isPhantomPending(b) then
                    skipBall = true
                elseif config.backwards_anti_curve and isBackwardsCurve(b, pos, zoomies.VectorVelocity) then
                    skipBall = true
                elseif tornado and now - ballState.state.AerodynamicTime < tornadoTime + 0.314159 then
                    skipBall = true
                elseif mainTarget == name and ballState.curved(b) then
                    skipBall = true
                end

                if not skipBall and bTarget == name and dist <= reach and parryState.accuracy * 0.8 then
                    parryController.fire()
                    parryState.debounce = true
                    parryState.until_at = now + 1
                    break
                end
            end
        end
    end
end

parryState.set = function(autoParry)
    local enabled = (autoParry == true)
    config.auto_parry = enabled
    parryState.debounce = false
    parryState.until_at = 0
    parryController.count = 0

    if runtimeConnections.auto_parry then
        runtimeConnections.auto_parry:Disconnect()
        runtimeConnections.auto_parry = nil
    end

    if enabled and _G.oxymod then
        runtimeConnections.auto_parry = postSimulation:Connect(parryState.check)
    end
end

