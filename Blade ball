local setBallStatsEnabled = nil

do
    local ScreenGui = nil
    local peakSpeeds = {}

    setBallStatsEnabled = function(ballDebug)
        local enabled = (ballDebug == true)
        config.ball_debug = enabled

        if runtimeConnections.ball_stats then
            runtimeConnections.ball_stats:Disconnect()
            runtimeConnections.ball_stats = nil
        end
        if ScreenGui then
            pcall(function() ScreenGui:Destroy() end)
            ScreenGui = nil
        end
        clearTable(peakSpeeds)

        if not enabled or not _G.oxymod then return end

        ScreenGui = createGuiInstance("ScreenGui", {
            Parent = localPlayer:WaitForChild("PlayerGui"),
            ResetOnSpawn = false,
        })
        local TextLabel = createGuiInstance("TextLabel", {
            Size = createUDim2(0.2, 0, 0.05, 0),
            Position = createUDim2(0.7, 0, 0.1, 0),
            TextSize = 26,
            BackgroundTransparency = 1,
            TextColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.Fantasy,
            Text = "waiting...",
            Parent = ScreenGui,
        })

        runtimeConnections.ball_stats = heartbeat:Connect(function()
            if not config.ball_debug or not _G.oxymod then return end
            local list = ballState.get_all()
            if #list == 0 then
                TextLabel.Text = "waiting..."
                TextLabel.TextColor3 = Color3.new(1, 1, 1)
                return
            end
            local activeSet = {}
            for _, b in ipairs(list) do activeSet[b] = true end
            for k in pairs(peakSpeeds) do
                if not activeSet[k] then peakSpeeds[k] = nil end
            end
            local maxSpd = 0
            local fastestBall = nil
            for _, b in ipairs(list) do
                local z = b:FindFirstChild("zoomies")
                if z then
                    local spd = maxValue(peakSpeeds[b] or 0, z.VectorVelocity.Magnitude)
                    peakSpeeds[b] = spd
                    if spd > maxSpd then
                        maxSpd = spd
                        fastestBall = b
                    end
                end
            end
            if fastestBall then
                local isLimit = maxSpd >= 2200
                TextLabel.Text = formatString("ball velocity: %.0f", maxSpd) .. (isLimit and " (LIMIT!)" or "")
                TextLabel.TextColor3 = isLimit and Color3.new(1, 0, 0) or Color3.new(1, 1, 1)
            else
                TextLabel.Text = "waiting..."
                TextLabel.TextColor3 = Color3.new(1, 1, 1)
            end
        end)
    end

    miscSection:toggle({
        name = "ball stats",
        flag = "misc.ball_debug",
        default = config.ball_debug or false,
        cb = setBallStatsEnabled,
    })
end

