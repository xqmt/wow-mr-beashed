remotes.ParrySuccessAll.OnClientEvent:Connect(function(_, part)
    local char = localPlayer.Character
    if not char or not char.PrimaryPart then return end

    if not (part and part.Parent and part.Parent ~= char and part.Parent.Parent ~= alive) then
        targetManager.closest()
        if targetManager.current and targetManager.current.PrimaryPart then
            local b = ballState.get()
            if b then
                local pos = char.PrimaryPart.Position
                local distTarget = (pos - targetManager.current.PrimaryPart.Position).Magnitude
                local offset = pos - ballState.position(b)
                local distBall = offset.Magnitude
                local velUnit = b.AssemblyLinearVelocity.Magnitude > 0 and b.AssemblyLinearVelocity.Unit or Vector3.zero
                local dot = offset.Magnitude > 0 and offset.Unit:Dot(velUnit) or 0
                if distTarget < 15 and distBall < 15 and dot > -0.25 and ballState.curved(b) then
                    parryController.fire()
                end
            end
        end
