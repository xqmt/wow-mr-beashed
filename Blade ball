local function serializeColor(c)
    if typeof(c) == "Color3" then
        return {r = c.R, g = c.G, b = c.B}
    end
    return {r = 115 / 255, g = 225 / 255, b = 1}
end

local function deserializeColor(val, fallback)
    if typeof(val) == "Color3" then
        return val
    end
    if type(val) == "table" then
        local r = tonumber(val.r or val[1])
        local g = tonumber(val.g or val[2])
        local b = tonumber(val.b or val[3])
        if r and g and b then
            return Color3.new(clampValue(r, 0, 1), clampValue(g, 0, 1), clampValue(b, 0, 1))
        end
    end
    return fallback
end

