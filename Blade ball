    local visImage = createInstance("ImageLabel")
    visImage.Name = "PosIcon"
    visImage.Size = UDim2.fromScale(1, 1)
    visImage.AnchorPoint = createVector2(0.5, 0.5)
    visImage.Position = UDim2.fromScale(0.5, 0.5)
    visImage.BackgroundTransparency = 1
    visImage.Image = VISUALIZER_IMAGE_ID
    visImage.ImageColor3 = immortalCfg.IconColor
    visImage.ImageTransparency = (immortalCfg.ShowVisualizer and immortalCfg.Enabled) and 0 or 1
    visImage.ScaleType = Enum.ScaleType.Fit
    visImage.Parent = visBillboard

    local visFadeTween = nil
    local visScaleTween = nil
    local visColorTween = nil
    local visCurrentTargetVisible = nil
    local visHideToken = 0

    local desiredTargetPos = nil
    local smoothVisualPos = nil
    local lastFakePos = nil
    local lastStepIndex = nil
    local running = true

    local fadeInInfo = createTweenInfo(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local fadeOutInfo = createTweenInfo(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    local colorTweenInfo = createTweenInfo(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

    local function getStepColor(stepIndex)
        local base = immortalCfg.IconColor or defaultImmortalIconColor
        if stepIndex == 1 then
            return Color3.new(base.R * 0.78, base.G * 0.78, base.B * 0.78)
        elseif stepIndex == 2 then
            return Color3.new(base.R * 0.58, base.G * 0.58, base.B * 0.58)
        end
        return base
    end

    local function setVisualizerFaded(visible)
        if not visBillboard or not visImage then return end
        if visCurrentTargetVisible == visible then return end
        visCurrentTargetVisible = visible

        visHideToken += 1
        local currentToken = visHideToken

        if visFadeTween then
            visFadeTween:Cancel()
            visFadeTween = nil
        end
        if visScaleTween then
            visScaleTween:Cancel()
            visScaleTween = nil
        end

        if visible then
            visBillboard.Enabled = true
            visImage.Size = UDim2.fromScale(0.82, 0.82)
            visFadeTween = TweenService:Create(visImage, fadeInInfo, {ImageTransparency = 0.08})
            visScaleTween = TweenService:Create(visImage, fadeInInfo, {Size = UDim2.fromScale(1, 1)})
            visFadeTween:Play()
            visScaleTween:Play()
        else
            visFadeTween = TweenService:Create(visImage, fadeOutInfo, {ImageTransparency = 1})
            visScaleTween = TweenService:Create(visImage, fadeOutInfo, {Size = UDim2.fromScale(0.75, 0.75)})
            visFadeTween.Completed:Connect(function(playbackState)
                if playbackState == Enum.PlaybackState.Completed and visHideToken == currentToken and not visCurrentTargetVisible then
                    if visBillboard then
                        visBillboard.Enabled = false
                    end
                end
            end)
            visFadeTween:Play()
            visScaleTween:Play()
        end
    end

    local function updateVisualizerVisibility()
        local char = getImmortalChar()
        local hrp = getImmortalHRP(char)
        local hum = getImmortalHum(char)
        local charReady = (hrp ~= nil and hum ~= nil and hum.Health > 0)
        local active = immortalCfg.ShowVisualizer and immortalCfg.Enabled and running and _G.oxymod and charReady
        setVisualizerFaded(active)
    end

    local function applyIconColor(col, stepIndex)
        if typeof(col) ~= "Color3" then return end
        immortalCfg.IconColor = col
        immortalIconColor = col
        config.immortal_icon_color = serializeColor(col)
        local targetColor = getStepColor(stepIndex or lastStepIndex or 0)
        if visImage then
            if visColorTween then
                visColorTween:Cancel()
            end
            visColorTween = TweenService:Create(visImage, colorTweenInfo, {ImageColor3 = targetColor})
            visColorTween:Play()
        end
    end

    local function setDesiredTarget(pos, stepIndex)
        desiredTargetPos = pos
        if stepIndex ~= lastStepIndex then
            lastStepIndex = stepIndex
            local targetColor = getStepColor(stepIndex)
            if visImage then
                if visColorTween then
                    visColorTween:Cancel()
                end
                visColorTween = TweenService:Create(visImage, colorTweenInfo, {ImageColor3 = targetColor})
                visColorTween:Play()
            end
        end
    end

    local function getCamAnchorPos(basePos)
        return basePos + createVector3(0, immortalCfg.CamHeightOffset, 0)
    end

    local function syncFakeCamera(dt)
        if not camAnchor or not camAnchor.Parent then return end
        local cam = currentCamera or Workspace.CurrentCamera
        local char = getImmortalChar()
        local hrp = getImmortalHRP(char)
        local hum = getImmortalHum(char)

        if not running or not _G.oxymod or not immortalCfg.Enabled or not hrp or not hum or hum.Health <= 0 then
            lastFakePos = nil
            if cam and cam.CameraSubject == camAnchor and hum then
                cam.CameraSubject = hum
            end
            return
        end

        local anchorPos = getCamAnchorPos(lastFakePos or hrp.Position)
        local camAlpha = 1 - math.exp(-immortalCfg.CamSmoothSpeed * clampValue(dt or 0.016, 0, 0.1))
        camAnchor.CFrame = createCFrame(camAnchor.Position:Lerp(anchorPos, camAlpha))

        if cam and cam.CameraSubject ~= camAnchor then
            cam.CameraSubject = camAnchor
        end
    end

    local function setPhysicsRate(rateStr)
        pcall(function()
            if setfflag then
                setfflag("S2PhysicsSenderRate", tostring(rateStr))
            end
        end)
    end

    local function restoreCameraAndPhysics()
        lastFakePos = nil
        local cam = currentCamera or Workspace.CurrentCamera
        local hum = getImmortalHum(getImmortalChar())
        if cam and cam.CameraSubject == camAnchor and hum then
            cam.CameraSubject = hum
        end
        setPhysicsRate(immortalCfg.PhysicsSenderRateDefault)
        updateVisualizerVisibility()
    end

    local function computeOffsetAndVelocity(t, baseCF, radius, spd)
        local lv = baseCF.LookVector
        local rv = baseCF.RightVector
        local mode = immortalCfg.Mode

        if mode == "strafe" then
            local dirSign = (floorValue(t / immortalCfg.StepInterval) % 2 == 0) and 1 or -1
            local stepIndex = dirSign == 1 and 0 or 1
            return rv * (radius * dirSign), rv * (spd * dirSign), stepIndex
        elseif mode == "orbit" then
            local angle = t * 9
            local cosA = math.cos(angle)
            local sinA = math.sin(angle)
            local offset = (rv * cosA + lv * sinA) * radius
            local tangent = (-rv * sinA + lv * cosA)
            local stepIndex = floorValue((angle % (math.pi * 2)) / ((math.pi * 2) / 3)) % 3
            return offset, tangent * spd, stepIndex
        end

        local stepIndex = floorValue(t / immortalCfg.StepInterval) % 3
        if stepIndex == 0 then
            return (-rv * radius) + (lv * (radius * 0.5)), -rv * spd, stepIndex
        elseif stepIndex == 1 then
            return (rv * radius) + (lv * (radius * 0.5)), rv * spd, stepIndex
        else
            return -lv * radius, -lv * spd, stepIndex
        end
    end

    local function stepImmortal()
        if not running or not _G.oxymod then
            restoreCameraAndPhysics()
            return
        end

        local char = getImmortalChar()
        local hrp = getImmortalHRP(char)
        local hum = getImmortalHum(char)
        local cam = currentCamera or Workspace.CurrentCamera

        if not hrp or not hum or hum.Health <= 0 or not cam then
            lastFakePos = nil
            if cam and cam.CameraSubject == camAnchor and hum then
                cam.CameraSubject = hum
            end
            setVisualizerFaded(false)
            return
        end

        if not immortalCfg.Enabled then
            restoreCameraAndPhysics()
            return
        end

        local baseCF = hrp.CFrame + createVector3(0, 0.01, 0)
        hrp.CFrame = baseCF
        lastFakePos = baseCF.Position

        if camAnchor and camAnchor.Parent then
            camAnchor.CFrame = createCFrame(getCamAnchorPos(baseCF.Position))
        end
        if cam.CameraSubject ~= camAnchor then
            cam.CameraSubject = camAnchor
        end
        setPhysicsRate(immortalCfg.PhysicsSenderRateActive)

        local offset, vel, stepIndex = computeOffsetAndVelocity(tick(), baseCF, immortalCfg.Radius, immortalCfg.VelocitySpeed)

        local origCF = baseCF
        local origVel = hrp.AssemblyLinearVelocity
        local targetCF = origCF * createCFrame(offset)

        updateVisualizerVisibility()
        if immortalCfg.ShowVisualizer then
            setDesiredTarget(targetCF.Position, stepIndex)
        end

        hrp.CFrame = targetCF
        hrp.AssemblyLinearVelocity = vel

        renderStepped:Wait()

        if hrp and hrp.Parent then
            hrp.CFrame = origCF
            hrp.AssemblyLinearVelocity = origVel
            lastFakePos = origCF.Position
        end
    end

    local hbConn = heartbeat:Connect(stepImmortal)
    local rsConn = renderStepped:Connect(function(dt)
        if not running or not _G.oxymod then return end
        syncFakeCamera(dt)
        if not immortalCfg.ShowVisualizer or not immortalCfg.Enabled then return end
        if not visPart or not visPart.Parent then return end
        local char = getImmortalChar()
        local hrp = getImmortalHRP(char)
        if not hrp then return end

        local alpha = 1 - math.exp(-immortalCfg.VisualizerSmoothSpeed * clampValue(dt, 0, 0.1))
        if desiredTargetPos then
            if not smoothVisualPos then
                smoothVisualPos = desiredTargetPos
            else
                smoothVisualPos = smoothVisualPos:Lerp(desiredTargetPos, alpha)
            end
            visPart.CFrame = createCFrame(smoothVisualPos)
        end
    end)

    local charConn = localPlayer.CharacterAdded:Connect(function()
        lastFakePos = nil
        smoothVisualPos = nil
        waitTask(0.1)
        if running and _G.oxymod and immortalCfg.Enabled then
            local hrp = getImmortalHRP(getImmortalChar())
            if hrp and camAnchor and camAnchor.Parent then
                camAnchor.CFrame = createCFrame(getCamAnchorPos(hrp.Position))
                lastFakePos = hrp.Position
            end
            updateVisualizerVisibility()
        end
    end)

    immortalController = {
        set_enabled = function(enabled)
            immortalCfg.Enabled = (enabled == true)
            config.immortal = immortalCfg.Enabled
            lastFakePos = nil
            smoothVisualPos = nil
            if not immortalCfg.Enabled then
                restoreCameraAndPhysics()
            else
                local hrp = getImmortalHRP(getImmortalChar())
                if hrp and camAnchor and camAnchor.Parent then
                    lastFakePos = hrp.Position
                    camAnchor.CFrame = createCFrame(getCamAnchorPos(hrp.Position))
                end
                updateVisualizerVisibility()
            end
        end,
        set_mode = function(modeVal)
            if findInTable(immortalModes, modeVal) then
                immortalCfg.Mode = modeVal
                config.immortal_mode = modeVal
            end
        end,
        set_visualizer = function(enabled)
            immortalCfg.ShowVisualizer = (enabled == true)
            config.immortal_visualizer = immortalCfg.ShowVisualizer
            updateVisualizerVisibility()
        end,
        set_icon_color = function(col)
            applyIconColor(col, lastStepIndex)
        end,
        set_range = function(val)
            local clamped = clampValue(roundValue(val), 1, 50)
            immortalCfg.Radius = clamped
            config.immortal_range = clamped
        end,
        destroy = function()
            running = false
            immortalCfg.Enabled = false
            if hbConn then hbConn:Disconnect(); hbConn = nil end
            if rsConn then rsConn:Disconnect(); rsConn = nil end
            if charConn then charConn:Disconnect(); charConn = nil end
            restoreCameraAndPhysics()
            if camAnchor then pcall(function() camAnchor:Destroy() end); camAnchor = nil end
            if visFolder then pcall(function() visFolder:Destroy() end); visFolder = nil end
        end,
    }

    if immortalCfg.Enabled then
        immortalController.set_enabled(true)
    end

    immortalSection:toggle({
        name = "immortal",
        flag = "combat.immortal",
        default = config.immortal or false,
        cb = function(v)
            immortalController.set_enabled(v)
        end,
    })

    immortalSection:dropdown({
        name = "mode",
        flag = "combat.immortal_mode",
        values = immortalModes,
        default = config.immortal_mode or "tri-step",
        cb = function(modeVal)
            immortalController.set_mode(modeVal)
        end,
    })

    immortalSection:toggle({
        name = "visualizer",
        flag = "combat.immortal_visualizer",
        default = config.immortal_visualizer ~= false,
        cb = function(v)
            immortalController.set_visualizer(v)
        end,
    })

    immortalSection:colorpicker({
        name = "icon color",
        flag = "combat.immortal_icon_color",
        default = immortalIconColor,
        cb = function(color)
            immortalController.set_icon_color(color)
        end,
    })

    immortalSection:slider({
        name = "range",
        flag = "combat.immortal_range",
        min = 1,
        max = 50,
        default = config.immortal_range or 14,
        cb = function(v)
            immortalController.set_range(v)
        end,
    })
end

