-- NO RENDER (NEW VERSION)
-- ═══════════════════════════════════════════════════════════
local noRenderEnable = nil

do
    local noRenderConnections = {}
    local noRenderCache = {}
    local noRenderEnabled = false
    local noRenderTransparency = NumberSequence.new(1)

    local noRenderStorage = {
        Spawn = true,
        Rhythm = true,
        Leaderboards = true,
        Map = true,
        UiClaimer = true,
    }

    local noRenderClasses = {
        ParticleEmitter = true,
        Beam = true,
        Trail = true,
        Smoke = true,
        Fire = true,
        Sparkles = true,
        PointLight = true,
        SpotLight = true,
        SurfaceLight = true,
    }

    local noRenderPaths = {
        "Workspace.Spawn.Limited",
        "Workspace.Spawn.ItemDuelsNPC",
        "Workspace.Spawn.AFK",
        "Workspace.Spawn.GroupCrate",
        "Workspace.Spawn.Portal",
        "Workspace.Spawn.ExplosionCratesSign",
        "Workspace.Spawn.SwordCratesSign",
        "Workspace.Spawn.MenuRings",
        "Workspace.Spawn.Spinnyy",
        "Workspace.Leaderboards",
        "Workspace.Rhythm.Runtime.Map.Decoration",
        "Workspace.Rhythm.Runtime.Map.Visuals",
        "Workspace.Rhythm.Track",
    }

    local function noRenderIsSound(obj)
        local className = obj.ClassName
        return className == "Sound"
            or className == "SoundGroup"
            or className:find("Audio", 1, true) ~= nil
    end

    local function noRenderHasSoundDescendant(obj)
        for _, desc in ipairs(obj:GetDescendants()) do
            if noRenderIsSound(desc) then
                return true
            end
        end
        return false
    end

    local function noRenderIsGui(obj)
        local pg = localPlayer and localPlayer:FindFirstChild("PlayerGui")
        return pg and obj:IsDescendantOf(pg)
    end

    local function noRenderIsWorkspaceStorage(obj)
        local current = obj
        while current and current.Parent and current.Parent ~= Workspace do
            current = current.Parent
        end
        return current and noRenderStorage[current.Name] == true
    end

    local function noRenderIsPath(obj)
        local fullName = obj:GetFullName()
        for _, path in ipairs(noRenderPaths) do
            if fullName == path or fullName:sub(1, #path + 1) == path .. "." then
                return true
            end
        end
        return false
    end

    local function noRenderStore(obj, props)
        noRenderCache[obj] = noRenderCache[obj] or {}
        for prop, value in pairs(props) do
            if noRenderCache[obj][prop] == nil then
                noRenderCache[obj][prop] = obj[prop]
            end
            pcall(function()
                obj[prop] = value
            end)
        end
    end

    local function noRenderRestore()
        for obj, props in pairs(noRenderCache) do
            if obj and obj.Parent then
                for prop, value in pairs(props) do
                    pcall(function()
                        obj[prop] = value
                    end)
                end
            end
        end
        clearTable(noRenderCache)
    end

    local function noRenderApply(obj, isGui)
        if not obj or not obj.Parent or noRenderIsSound(obj) or obj:IsA("Highlight") then
            return
        end
        if noRenderClasses[obj.ClassName] then
            if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") then
                noRenderStore(obj, { Enabled = false, Transparency = noRenderTransparency })
            else
                noRenderStore(obj, { Enabled = false })
            end
            if obj:IsA("ParticleEmitter") then
                pcall(function()
                    obj:Clear()
                end)
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            noRenderStore(obj, { Transparency = 1 })
        elseif isGui and (obj:IsA("SurfaceGui") or obj:IsA("BillboardGui")) then
            noRenderStore(obj, { Enabled = false })
        elseif obj:IsA("BasePart") then
            if noRenderIsGui(obj) or noRenderHasSoundDescendant(obj) then
                return
            end
            if noRenderIsPath(obj) then
                noRenderStore(obj, { LocalTransparencyModifier = 1 })
            end
        end
    end

    local function noRenderProcess(obj)
        if not obj or not obj.Parent or noRenderIsSound(obj) then
            return
        end
        if obj:IsDescendantOf(Workspace) then
            local root = obj
            while root and root.Parent and root.Parent ~= Workspace do
                root = root.Parent
            end
            if root and (root.Name:find("PortalFor_") or root.Name:find("WaypointFor_") or noRenderStorage[root.Name]) then
                return
            end
            noRenderApply(obj, false)
        elseif (obj:IsA("SurfaceGui") or obj:IsA("BillboardGui")) and noRenderIsWorkspaceStorage(obj) then
            noRenderApply(obj, true)
        else
            noRenderApply(obj, false)
        end
    end

    noRenderEnable = function(enabled)
        local active = (enabled == true) and (_G.oxymod == true)
        noRenderEnabled = (enabled == true)
        config.no_render = noRenderEnabled

        for _, conn in ipairs(noRenderConnections) do
            if conn.Connected then
                conn:Disconnect()
            end
        end
        clearTable(noRenderConnections)

        if not active then
            noRenderRestore()
            return
        end

        local descendants = Workspace:GetDescendants()
        for _, obj in ipairs(descendants) do
            noRenderProcess(obj)
        end

        noRenderConnections[#noRenderConnections + 1] = Workspace.DescendantAdded:Connect(function(obj)
            if not noRenderEnabled or not _G.oxymod then
                return
            end
            if noRenderIsSound(obj) then
                return
            end
            noRenderProcess(obj)
        end)
    end

    noRenderDestroy = function()
        noRenderEnabled = false
        for _, conn in ipairs(noRenderConnections) do
            if conn.Connected then
                conn:Disconnect()
            end
        end
        clearTable(noRenderConnections)
        noRenderRestore()
    end

    miscSection:toggle({
        name = "no render",
        flag = "misc.no_render",
        default = config.no_render or false,
        cb = noRenderEnable,
    })
end

