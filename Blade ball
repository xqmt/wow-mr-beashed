        self.labels[player] = nil
    end
end

abilityEspState.detach_respawn = function(self, player)
    local conn = self.respawn_conns[player]
    if conn then
        pcall(function() conn:Disconnect() end)
        self.respawn_conns[player] = nil
    end
end

abilityEspState.attach_player = function(self, player)
    if player == localPlayer then return end
    self:remove_player(player)

    local char = player.Character
    if not char then
        local ok, result = pcall(function() return player.CharacterAdded:Wait() end)
        if not ok or not self.running then return end
        char = result
    end
    if not self.running then return end

    local head = char:WaitForChild("Head", 5)
    if not head or not self.running then return end

    local sGui = (gethui and gethui()) or localPlayer:WaitForChild("PlayerGui")

    local BGui = createInstance("BillboardGui")
    BGui.Name = "Oxy_AbilityESP"
    BGui.AlwaysOnTop = true
    BGui.Size = createUDim2(0, 140, 0, 40)
    BGui.StudsOffset = createVector3(0, 3.0, 0)
    BGui.Adornee = head
    BGui.Parent = sGui
    self.labels[player] = BGui

    local Icon = createInstance("ImageLabel")
    Icon.Size = fromOffset(26, 26)
    Icon.Position = fromOffset(5, 7)
    Icon.BackgroundTransparency = 1
    Icon.Image = "rbxassetid://3944703587"
    Icon.Parent = BGui

    local StatusLbl = createInstance("TextLabel")
    StatusLbl.BackgroundTransparency = 1
    StatusLbl.Size = fromOffset(95, 14)
    StatusLbl.Position = fromOffset(36, 5)
    StatusLbl.Text = "NONE"
    StatusLbl.TextColor3 = colorFromRGB(255, 255, 255)
    StatusLbl.TextSize = 10
    StatusLbl.Font = Enum.Font.GothamBold
    StatusLbl.TextXAlignment = Enum.TextXAlignment.Left
    StatusLbl.TextStrokeTransparency = 0
    StatusLbl.Parent = BGui

    local ReadyLbl = createInstance("TextLabel")
    ReadyLbl.BackgroundTransparency = 1
    ReadyLbl.Size = fromOffset(95, 14)
    ReadyLbl.Position = fromOffset(36, 18)
    ReadyLbl.Text = "READY"
    ReadyLbl.TextColor3 = colorFromRGB(80, 220, 120)
    ReadyLbl.TextSize = 10
    ReadyLbl.Font = Enum.Font.GothamBlack
    ReadyLbl.TextXAlignment = Enum.TextXAlignment.Left
    ReadyLbl.TextStrokeTransparency = 0
    ReadyLbl.Parent = BGui

    spawnTask(function()
        while BGui and BGui.Parent and self.running do
            pcall(function()
                local liveChar = player.Character
                if not liveChar then return end

                local liveHead = liveChar:FindFirstChild("Head")
                if liveHead and BGui.Adornee ~= liveHead then
                    BGui.Adornee = liveHead
                end

                local rawAbility = player:GetAttribute("EquippedAbility") or player:GetAttribute("Ability") or "None"
                StatusLbl.Text = string.upper(tostring(rawAbility))

                if config.ability_esp_icon ~= false then
                    local abilityFolder = DataAbilities:FindFirstChild(tostring(rawAbility))
                    if abilityFolder then
                        local assetIcon = abilityFolder:GetAttribute("Icon") or abilityFolder:GetAttribute("Icon1")
                        Icon.Image = (assetIcon and assetIcon ~= "") and assetIcon or "rbxassetid://3944703587"
                    else
                        Icon.Image = "rbxassetid://3944703587"
                    end
                end

                if config.ability_esp_cooldown ~= false then
                    local abActive = liveChar:GetAttribute("AbilityActive") == true
                    local cdActive = liveChar:GetAttribute("CooldownActive") == true
                    local cdExpiry = player:GetAttribute("CooldownExpiration")
                    local cdExpired = cdExpiry and Workspace:GetServerTimeNow() < cdExpiry
                    local isReady = not (abActive or cdActive or cdExpired)

                    if isReady then
                        ReadyLbl.Text = "READY"
                        ReadyLbl.TextColor3 = colorFromRGB(80, 220, 120)
                    else
                        local cdDiff = cdExpiry and (cdExpiry - Workspace:GetServerTimeNow()) or 0
                        ReadyLbl.Text = cdDiff > 0 and string.format("%.1fS", cdDiff) or "COOLDOWN"
                        ReadyLbl.TextColor3 = colorFromRGB(220, 100, 80)
                    end
                end
            end)
            waitTask(0.2)
        end
        pcall(function()
            if BGui and BGui.Parent then BGui:Destroy() end
        end)
        if self.labels[player] == BGui then
            self.labels[player] = nil
        end
    end)
end

abilityEspState.hook_respawn = function(self, player)
    self:detach_respawn(player)
    self.respawn_conns[player] = player.CharacterAdded:Connect(function()
        if not self.running then return end
        delayTask(0.3, function()
            if self.running then
                spawnTask(function() self:attach_player(player) end)
            end
        end)
    end)
end

abilityEspState.set = function(self, on)
    local enabled = (on == true)
    config.ability_esp = enabled
    self.running = false
    if self.active_task then
        pcall(function() task.cancel(self.active_task) end)
        self.active_task = nil
    end
    for player in pairs(self.respawn_conns) do
        self:detach_respawn(player)
    end
    clearTable(self.respawn_conns)
    for player in pairs(self.labels) do
        self:remove_player(player)
    end
    clearTable(self.labels)

    if not enabled or not _G.oxymod then return end
    self.running = true

    self.active_task = spawnTask(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer then
                self:hook_respawn(p)
                spawnTask(function() self:attach_player(p) end)
            end
        end

        local connAdded = Players.PlayerAdded:Connect(function(p)
            if not self.running or p == localPlayer then return end
            self:hook_respawn(p)
            spawnTask(function() self:attach_player(p) end)
        end)

        local connRemoving = Players.PlayerRemoving:Connect(function(p)
            self:detach_respawn(p)
            self:remove_player(p)
        end)

        while self.running do
            waitTask(0.5)
        end

        pcall(function() connAdded:Disconnect() end)
        pcall(function() connRemoving:Disconnect() end)
        for player in pairs(self.respawn_conns) do
            self:detach_respawn(player)
        end
        clearTable(self.respawn_conns)
        for player in pairs(self.labels) do
            self:remove_player(player)
        end
        clearTable(self.labels)
    end)
end

