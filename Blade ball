-- PARRY VISUALIZE (AUTO PARRY RADIUS RING + COLOR PICKER)
-- ═══════════════════════════════════════════════════════════
do
    local SEGMENTS = 64
    local visFolder = createInstance("Folder")
    visFolder.Name = "OxymodParryVisualize"
    visFolder.Parent = Workspace

    local ringPart = createInstance("Part")
    ringPart.Name = "ParryRadiusDisc"
    ringPart.Shape = Enum.PartType.Cylinder
    ringPart.Material = Enum.Material.Neon
    ringPart.Color = parryVisColor
    ringPart.Transparency = 0.84
    ringPart.CanCollide = false
    ringPart.CanTouch = false
    ringPart.CanQuery = false
    ringPart.Anchored = true
    ringPart.CastShadow = false
    ringPart.Size = createVector3(0.08, 1, 1)
    ringPart.Parent = visFolder

    local outlinePart = createInstance("Part")
    outlinePart.Name = "ParryRadiusRim"
    outlinePart.Material = Enum.Material.Neon
    outlinePart.Color = parryVisColor
    outlinePart.Transparency = 0.25
    outlinePart.CanCollide = false
    outlinePart.CanTouch = false
    outlinePart.CanQuery = false
    outlinePart.Anchored = true
    outlinePart.CastShadow = false
    outlinePart.Size = createVector3(0.14, 0.14, 1)
    outlinePart.Parent = visFolder

    local segmentParts = {}
    for i = 1, SEGMENTS do
        local seg = createInstance("Part")
        seg.Name = "RimSeg_" .. tostring(i)
        seg.Material = Enum.Material.Neon
        seg.Color = parryVisColor
        seg.Transparency = 0.2
        seg.CanCollide = false
        seg.CanTouch = false
        seg.CanQuery = false
        seg.Anchored = true
        seg.CastShadow = false
        seg.Size = createVector3(0.12, 0.14, 1)
        seg.Parent = visFolder
        segmentParts[i] = seg
    end

    local visConn = nil
    local currentRadius = 12
    local initializedRadius = false

    local function setVisVisible(visible)
        local tFill = visible and 0.84 or 1
        local tSeg = visible and 0.2 or 1
        ringPart.Transparency = tFill
        outlinePart.Transparency = 1
        for i = 1, SEGMENTS do
            segmentParts[i].Transparency = tSeg
        end
    end

    local function applyVisColor(col)
        if typeof(col) ~= "Color3" then return end
        parryVisColor = col
        config.parry_visualize_color = serializeColor(col)
        ringPart.Color = col
        outlinePart.Color = col
        for i = 1, SEGMENTS do
            segmentParts[i].Color = col
        end
    end

    local function getActiveParryRadius()
        local activeBall = ballState.get()
        for _, b in ipairs(ballState.get_all()) do
            if b:GetAttribute("target") == name then
                activeBall = b
                break
            end
        end
        return computeParryRadius(activeBall, parryState.accuracy)
    end

    local function updateParryVisualize(dt)
        if not config.parry_visualize or not _G.oxymod then
            setVisVisible(false)
            return
        end

        local char = localPlayer.Character
        local root = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))
        if not root then
            setVisVisible(false)
            return
        end

        local targetRadius = clampValue(getActiveParryRadius(), 4, 120)
        if not initializedRadius then
            currentRadius = targetRadius
            initializedRadius = true
        else
            local alpha = 1 - math.exp(-16 * clampValue(dt or 0.016, 0, 0.1))
            currentRadius = lerpValue(currentRadius, targetRadius, alpha)
        end

        local centerPos = root.Position - createVector3(0, 2.2, 0)
        setVisVisible(true)

        local diameter = currentRadius * 2
        ringPart.Size = createVector3(0.08, diameter, diameter)
        ringPart.CFrame = createCFrame(centerPos) * CFrame.Angles(0, 0, math.rad(90))

        local stepAngle = (math.pi * 2) / SEGMENTS
        local chordLen = maxValue(2 * currentRadius * math.sin(stepAngle * 0.5) + 0.06, 0.1)
        for i = 1, SEGMENTS do
            local a0 = (i - 1) * stepAngle
            local a1 = i * stepAngle
            local p0 = centerPos + createVector3(math.cos(a0) * currentRadius, 0, math.sin(a0) * currentRadius)
            local p1 = centerPos + createVector3(math.cos(a1) * currentRadius, 0, math.sin(a1) * currentRadius)
            local mid = (p0 + p1) * 0.5
            local seg = segmentParts[i]
            seg.Size = createVector3(0.12, 0.14, chordLen)
            seg.CFrame = CFrame.lookAt(mid, p1)
        end
    end

    local function setParryVisualizeEnabled(enabled)
        local active = (enabled == true) and (_G.oxymod == true)
        config.parry_visualize = (enabled == true)
        initializedRadius = false

        if visConn then
            visConn:Disconnect()
            visConn = nil
        end

        if not active then
            setVisVisible(false)
            return
        end

        visConn = renderStepped:Connect(updateParryVisualize)
    end

    parryVisController = {
        set_enabled = setParryVisualizeEnabled,
        set_color = applyVisColor,
        destroy = function()
            setParryVisualizeEnabled(false)
            if visFolder then
                pcall(function() visFolder:Destroy() end)
                visFolder = nil
            end
        end,
    }

    visualSection:toggle({
        name = "parry visualize",
        flag = "visual.parry_visualize",
        default = config.parry_visualize or false,
        cb = function(v)
            parryVisController.set_enabled(v)
        end,
    })

    visualSection:colorpicker({
        name = "color",
        flag = "visual.color.parry_visualize",
        default = parryVisColor,
        cb = function(color)
            parryVisController.set_color(color)
        end,
    })
end

