    if speed == 0 then return end
    local dist = (char.PrimaryPart.Position - ballState.position(b)).Magnitude
    local ping = dataPing:GetValue()
    local timeArr = dist / speed - ping / 1000
    local safeRad = 15 - minValue(dist / 1000, 15) + minValue(speed / 100, 40)
    if speed > 100 and timeArr > ping / 10 then
        safeRad = maxValue(safeRad - 15, 15)
    end
    if part ~= char.PrimaryPart and dist > safeRad then
        ballState.state.Curving = tick()
    end
end)

