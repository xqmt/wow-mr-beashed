triggerbotState.fire = function(b)
    if triggerbotState.busy then return end
    triggerbotState.busy = true
    parryController.fire()
    b:GetAttributeChangedSignal("target"):Once(function()
        triggerbotState.busy = false
    end)
    local start = tick()
    spawnTask(function()
        while true do
