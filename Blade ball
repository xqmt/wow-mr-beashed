configStorage.changed = function()
    if not configStorage.has_saved then return true end
    for k in pairs(configStorage.defaults) do
        local a, b = configStorage.last_saved[k], config[k]
        if type(a) == "table" or type(b) == "table" then
            if not configStorage.equal(a, b) then return true end
        elseif a ~= b then
            return true
        end
    end
    return false
end

configStorage.save = function()
    if not configStorage.storage_ok or not configStorage.changed() then return end
    local t = {}
    for k, def in pairs(configStorage.defaults) do
        local v = config[k]
        if type(def) == "table" then
            t[k] = type(v) == "table" and configStorage.copy(v) or configStorage.copy(def)
        else
            t[k] = type(v) == type(def) and v or def
        end
    end
    local ok, encoded = pcall(function() return httpService:JSONEncode(t) end)
    if not ok then return end
    configStorage.ensure_folder()
    if not pcall(writefile, configStorage.path, encoded) then return end
    for k in pairs(configStorage.defaults) do
        local v = t[k]
        configStorage.last_saved[k] = type(v) == "table" and configStorage.copy(v) or v
    end
    configStorage.has_saved = true
end

configStorage.save()
spawnTask(function()
