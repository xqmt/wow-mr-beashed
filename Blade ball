targetManager.pick_random = function()
    local candidates = {}
    for _, entity in ipairs(alive:GetChildren()) do
        if entity.Name ~= name and entity.PrimaryPart then
            insertIntoTable(candidates, entity)
        end
    end
    if #candidates == 0 then
        targetManager.current = nil
        return
    end
    if #candidates == 1 then
        targetManager.current = candidates[1]
        return
    end
    local unvisited = {}
    for _, entity in ipairs(candidates) do
        if not targetManager.visited[entity.Name] then
            insertIntoTable(unvisited, entity)
        end
    end
    if #unvisited == 0 then
        targetManager.visited = {}
        for _, entity in ipairs(candidates) do
            if not targetManager.current or entity.Name ~= targetManager.current.Name then
                insertIntoTable(unvisited, entity)
            end
        end
        if #unvisited == 0 then
            unvisited = candidates
        end
    end
    local chosen = unvisited[randomValue(1, #unvisited)]
    targetManager.visited[chosen.Name] = true
    targetManager.current = chosen
end

local touchEnabled = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local mouseEnabled = UserInputService.MouseEnabled or not touchEnabled

targetManager.by_mouse = function()
    local candidates = {}
    for _, entity in ipairs(alive:GetChildren()) do
        if entity.Name ~= name and entity.PrimaryPart then
            insertIntoTable(candidates, entity)
        end
    end
    if #candidates == 0 then
        targetManager.current = nil
        return nil
    end
    local cam = currentCamera or Workspace.CurrentCamera
    local cf = cam.CFrame
    local origin = cf.Position
    local look = cf.LookVector
    local dir
    if mouseEnabled then
        local ml = UserInputService:GetMouseLocation()
        dir = cam:ScreenPointToRay(ml.X, ml.Y).Direction
    else
        local vs = cam.ViewportSize
        dir = cam:ViewportPointToRay(vs.X * 0.5, vs.Y * 0.5).Direction
    end
    local bestDot = -math.huge
    local bestTarget = nil
    for _, entity in ipairs(candidates) do
        local diff = entity.PrimaryPart.Position - origin
        if diff.Magnitude > 0 then
            local unit = diff.Unit
            if look:Dot(unit) > 0 then
                local d = dir:Dot(unit)
                if d > bestDot then
                    bestDot = d
                    bestTarget = entity
                end
            end
        end
    end
    bestTarget = bestTarget or candidates[1]
    targetManager.current = bestTarget
    return bestTarget
end

targetManager.closest = function()
    if config.random_target then
        if not targetManager.current then
            targetManager.pick_random()
        end
        return targetManager.current
    end
    return targetManager.by_mouse()
end

targetManager.props = function()
    local current = targetManager.current or targetManager.closest()
    if not current or not current.PrimaryPart then
        return false
    end
    local char = localPlayer.Character
    local root = char and char.PrimaryPart
    if not root then
        return false
    end
    local pos = root.Position
    return {
        velocity = current.PrimaryPart.Velocity,
        direction = (pos - current.PrimaryPart.Position).Unit,
        distance = (pos - current.PrimaryPart.Position).Magnitude,
    }
end

curveController.get_cframe = function()
    local cf = (currentCamera or Workspace.CurrentCamera).CFrame
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return cf end

    local targetPos = (targetManager.current and targetManager.current.PrimaryPart and targetManager.current.PrimaryPart.Position)
        or (hrp.Position + cf.LookVector * 1000)
    local unit = (targetPos - hrp.Position).Unit
    local method = config.curve_method

    if method == "dot" then
        return CFrame.lookAt(hrp.Position, targetPos + createVector3(0, 1.75, 0))
    elseif method == "backwards" then
        return createCFrame(hrp.Position, hrp.Position + -unit * 1000)
    elseif method == "slow" then
        return createCFrame(hrp.Position, hrp.Position + createVector3(0, -350, 0))
    elseif method == "random" then
        return createCFrame(hrp.Position, targetPos + createVector3(randomValue(-1000, 1000), randomValue(-350, 1000), randomValue(-1000, 1000)))
    end
    return cf
end

curveController.sync_dropdown = function(val)
    if curveController.dropdown then
        curveController.syncing = true
        curveController.dropdown:set(val)
        curveController.syncing = false
    end
end

swordAnimationState.find = function(folder)
    local anim = folder:FindFirstChild("GrabParry") or folder:FindFirstChild("Parry") or folder:FindFirstChild("Grab")
    if anim then return anim end
    local base = folder:FindFirstChild("Base")
    if base then
        return base:FindFirstChild("GrabParry") or base:FindFirstChild("Parry") or base:FindFirstChild("Grab")
    end
    return nil
end

swordAnimationState.resolve = function(char, swordName)
    if not swordName then return nil end
    if swordAnimationState.cache[swordName] and swordAnimationState.cache[swordName].Parent then
        return swordAnimationState.cache[swordName]
    end
    local shared = ReplicatedStorage:FindFirstChild("Shared")
    if not shared then return nil end
    local rep = shared:FindFirstChild("ReplicatedInstances")
    local swords = rep and rep:FindFirstChild("Swords")
    local getSword = swords and swords:FindFirstChild("GetSword")
    local swordData = nil
    if getSword then
        pcall(function()
            swordData = getSword:Invoke(swordName)
        end)
    end
    local animType = (swordData and swordData.AnimationType) or "Single"
    local swordType = (swordData and swordData.SwordType) or "Single"

    if swordAnimationState.api and type(swordAnimationState.api.GetAnimations) == "function" then
        local ok, anims = pcall(function()
            return swordAnimationState.api:GetAnimations(char, {"Parry", "GrabParry"}, animType, swordType)
        end)
        if ok and type(anims) == "table" and anims[1] then
            swordAnimationState.cache[swordName] = anims[1]
            return anims[1]
        end
    end

    local collection = shared:FindFirstChild("SwordAPI")
    if collection then
        collection = collection:FindFirstChild("Collection") or collection
        local animFolder = collection:FindFirstChild(animType) or collection:FindFirstChild("Default")
        if animFolder then
            local found = swordAnimationState.find(animFolder)
            if found then
                swordAnimationState.cache[swordName] = found
                return found
            end
        end
    end
    return nil
end

swordAnimationState.grab = function(isSpam)
    local char = localPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not hum or not animator then return false end

    local equippedSword
    if globalEnvironment and globalEnvironment.skinChangerEnabled and globalEnvironment.swordAnimations then
        equippedSword = globalEnvironment.swordAnimations
    else
        equippedSword = char:GetAttribute("CurrentlyEquippedSword") or "Base Sword"
    end

    local animObj = swordAnimationState.resolve(char, equippedSword)
    if not animObj then return false end

    local trackMap = swordAnimationState.tracks[animator]
    if not trackMap then
        trackMap = {}
        swordAnimationState.tracks[animator] = trackMap
    end

    local track = trackMap[animObj]
    if not track or not track.Parent or track.Parent ~= animator then
        local ok, loaded = pcall(function() return animator:LoadAnimation(animObj) end)
        if not ok or not loaded then return false end
        track = loaded
        for k, v in pairs(animObj:GetAttributes()) do
            track:SetAttribute(k, v)
        end
        track:SetAttribute("GrabParry", true)
        track.Priority = Enum.AnimationPriority.Action4
        trackMap[animObj] = track
    end

    if isSpam then
        local now = tick()
        if now - swordAnimationState.last_spam < swordAnimationState.cancel_delay then
            local playing = false
            if swordAnimationState.active then
                pcall(function() playing = swordAnimationState.active.IsPlaying end)
            end
            if playing then
                char:SetAttribute("ParryTime", maxValue(char:GetAttribute("ParryTime") or 0, swordAnimationState.active.Length ~= 0 and swordAnimationState.active.Length or 1))
                return true
            end
        end
        swordAnimationState.last_spam = now
    else
        swordAnimationState.last_spam = 0
    end

    swordAnimationState.generation = swordAnimationState.generation + 1
    local gen = swordAnimationState.generation

    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
        if t:GetAttribute("GrabParry") or t:GetAttribute("Parry") or t:GetAttribute("SuccessParry") then
            pcall(t.Stop, t, t:GetAttribute("StopFadeTime") or 0.05)
        end
    end

    local fadeIn = animObj:GetAttribute("PlayFadeTime") or 0.05
    local weight = animObj:GetAttribute("PlayWeight") or 1
    local speed = animObj:GetAttribute("PlaySpeed") or 1
    track.TimePosition = 0
    track:Play(fadeIn, weight, speed)
    swordAnimationState.active = track
    char:SetAttribute("ParryTime", maxValue(char:GetAttribute("ParryTime") or 0, track.Length ~= 0 and (track.Length - track.TimePosition) * speed or 1))

    if isSpam then
        local delayTime = swordAnimationState.cancel_delay
        local len = track.Length or 0
        if len > 0 then
            delayTime = minValue(delayTime, len * swordAnimationState.cancel_fraction)
        end
        if delayTime < 0.05 then delayTime = 0.05 end
        local stopFade = animObj:GetAttribute("StopFadeTime") or 0.05
        delayTask(delayTime, function()
            if gen == swordAnimationState.generation and swordAnimationState.active == track then
                pcall(track.Stop, track, stopFade)
            end
        end)
    end
    return true
end

parryController.fire = function(isSpam)
    local cam = currentCamera or Workspace.CurrentCamera
    if not config.random_target then
        targetManager.by_mouse()
    end
    local curveCFrame = curveController.get_cframe()
    local primaryPart = targetManager.current and targetManager.current.PrimaryPart
    local coordinates
    if primaryPart then
        local pt = cam:WorldToViewportPoint(primaryPart.Position)
        coordinates = {pt.X, pt.Y}
    elseif not touchEnabled then
        local ml = UserInputService:GetMouseLocation()
        coordinates = {ml.X, ml.Y}
    else
        local vs = cam.ViewportSize
        coordinates = {vs.X * 0.5, vs.Y * 0.5}
    end

    local targets = {}
    for _, ch in ipairs(alive:GetChildren()) do
        local pp = ch.PrimaryPart
        if pp then
            local pt3, vis = cam:WorldToScreenPoint(pp.Position)
            if vis or pt3.Z > 0 then
                targets[ch.Name] = pt3
            end
        end
    end

    local fired = false
    if next(eventCapture.captured) ~= nil then
        swordAnimationState.grab(isSpam)
        for remote, captured in pairs(eventCapture.captured) do
            local seed = captured[2]
            local token = eventCapture.polygon(seed)
            local args = {captured[1], seed, token, 0.5, curveCFrame, targets, coordinates, false}
            local ok
            if remote:IsA("RemoteEvent") then
                ok = pcall(function() remote:FireServer(unpack(args)) end)
            elseif remote:IsA("RemoteFunction") then
                ok = pcall(function() remote:InvokeServer(unpack(args)) end)
            end
            if ok then fired = true end
        end
    end

    if not fired then
        if not parryController.first_signal then
            local controllers2 = ReplicatedStorage:FindFirstChild("Controllers")
            if controllers2 then
                for _, ctrl in ipairs(controllers2:GetChildren()) do
                    if ctrl.Name:find("SwordsController", 1, true) == 1 then
                        local pry = ctrl:FindFirstChild("PRY")
                        if pry then
                            local ok2, fn = pcall(require, pry)
                            if ok2 and type(fn) == "function" then
                                parryController.first_signal = require(packages.Signal).new()
                                parryController.first_signal:Connect(fn)
                                break
                            end
                        end
                    end
                end
            end
        end
        if parryController.first_signal then
            parryController.first_signal:Fire(0.5, curveCFrame, targets, coordinates, false)
            if isSpam then swordAnimationState.grab(true) end
        end
    end

    if parryController.count > 7 then
        return false
    end
    parryController.count = parryController.count + 1
    delayTask(0.5, function()
        if parryController.count > 0 then
            parryController.count = parryController.count - 1
        end
    end)
    return true
end

