-- INITIAL STATE SYNC
-- ═══════════════════════════════════════════════════════════
syncAllTogglesFromConfig = function()
    if not _G.oxymod then return end
    parryState.set(config.auto_parry == true)
    spamController.set_auto(config.auto_spam == true)
    abilityEspState:set(config.ability_esp == true)
    if setDisableHighlightsEnabled then
        setDisableHighlightsEnabled(config.disable_highlights == true)
    end
    if parryVisController then
        parryVisController.set_color(parryVisColor)
        parryVisController.set_enabled(config.parry_visualize == true)
    end
    if setBallStatsEnabled then
        setBallStatsEnabled(config.ball_debug == true)
    end
    if noRenderEnable then
        noRenderEnable(config.no_render == true)
    end
    if setAntiLagEnabled then
        setAntiLagEnabled(config.antilag == true)
    end
    if characterCosmeticsController then
        characterCosmeticsController.refresh()
    end
    if immortalController then
        immortalController.set_mode(config.immortal_mode or "tri-step")
        immortalController.set_icon_color(immortalIconColor)
        immortalController.set_enabled(config.immortal == true)
        immortalController.set_visualizer(config.immortal_visualizer ~= false)
        immortalController.set_range(config.immortal_range or 14)
    end
    if inventoryUnlockManager and inventoryUnlockManager.ready then
        inventoryUnlockManager:set_enabled(config.unlock_all == true)
    end
end

deferTask(syncAllTogglesFromConfig)
