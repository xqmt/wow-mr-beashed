        sword_attr_connection = nil,
    }

    local function toggleConn(conn, enable)
        pcall(function()
            if enable then conn:Enable() else conn:Disable() end
        end)
    end

    inventoryUnlockManager.set_sword_override = function(self, state)
        for _, conn in ipairs(self.parry_connections) do toggleConn(conn, not state) end
        for _, conn in ipairs(self.fire_connections) do toggleConn(conn, not state) end
    end

    inventoryUnlockManager.apply_chroma = function(_, inst, data)
        local colorConfig = data.ColorConfig or data.TweenColorConfig
        if not colorConfig and (data.Name:find("Chroma") or data.Name:find("Rainbow")) then
            colorConfig = "Chroma"
        end
        if colorConfig then
            inst:SetAttribute("ColorConfig", colorConfig)
            inst:AddTag("TweenColor")
        end
    end

    inventoryUnlockManager.slot_fav_visual = function(self, cat, slot)
        if not slot or not slot:IsA("GuiObject") then return end
        local itemName = slot:GetAttribute("Name")
        if not itemName or itemName == "" then return end
        local fav = self:is_fav(cat, itemName)
        local favImg = slot:FindFirstChild("Favorited")
        if favImg and favImg:IsA("ImageLabel") then
            favImg.Visible = fav
            if fav then favImg.Image = "rbxassetid://15697987058" end
        end
        local shadow = slot:FindFirstChild("Shadow")
        if shadow and self.unlocked[cat] then
            shadow.Enabled = false
        end
    end

    inventoryUnlockManager.native_fav_map = function(self)
        if self.native_map then return self.native_map end
        if not self.shop_controller or type(self.shop_controller._inventoryPages) ~= "table" then return nil end
        for _, page in pairs(self.shop_controller._inventoryPages) do
            if type(page) == "table" and type(page.MarkDirty) == "function" then
                local ok1, up1 = pcall(debug.getupvalues, page.MarkDirty)
                if ok1 and type(up1) == "table" then
                    for _, f1 in pairs(up1) do
                        if type(f1) == "function" then
                            local ok2, up2 = pcall(debug.getupvalues, f1)
                            if ok2 and type(up2) == "table" then
                                for _, f2 in pairs(up2) do
                                    if type(f2) == "function" then
                                        local ok3, up3 = pcall(debug.getupvalues, f2)
                                        if ok3 and type(up3) == "table" then
                                            for _, tbl in pairs(up3) do
                                                if type(tbl) == "table" and tbl.Sword ~= nil and tbl.Explosion ~= nil and not tbl._virtualItems then
                                                    self.native_map = tbl
                                                    return tbl
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        return nil
    end

    inventoryUnlockManager.sync_fav_map = function(self, cat)
        local map = self:native_fav_map()
        if not map then return end
        local sub = map[cat]
        if type(sub) ~= "table" then return end
        local favTable = (cat == "Sword" and config.favorite_swords) or (cat == "Explosion" and config.favorite_explosions) or {}
        for k in pairs(sub) do
            if not favTable[k] then sub[k] = nil end
        end
        for k, v in pairs(favTable) do
            sub[k] = (v and true) or nil
        end
    end

    inventoryUnlockManager.is_fav = function(_, cat, itemName)
        if cat == "Sword" then return config.favorite_swords and config.favorite_swords[itemName] == true end
        if cat == "Explosion" then return config.favorite_explosions and config.favorite_explosions[itemName] == true end
        return false
    end

    inventoryUnlockManager.is_deleted = function(_, cat, itemName)
        if cat == "Sword" then return config.deleted_swords and config.deleted_swords[itemName] == true end
        if cat == "Explosion" then return config.deleted_explosions and config.deleted_explosions[itemName] == true end
        return false
    end

    inventoryUnlockManager.refresh_shop_item = function(self, cat, itemName, owned)
        local items = self.shop_controller and self.shop_controller._virtualItems[cat]
        local page = self.shop_controller and self.shop_controller._inventoryPages[cat]
        if type(items) == "table" then
            for _, item in pairs(items) do
                if item.Name == itemName then
                    item.Section = owned and "Owned" or "Unowned"
                    if item.OwnsItem and type(item.OwnsItem.Set) == "function" then
                        pcall(item.OwnsItem.Set, item.OwnsItem, owned)
                    end
                    if not owned then
                        item.IsFavorited = false
                        item.Name_ = (item.Name_ or item.Name):gsub("^#", "")
                        item.LayoutOrder = item.OriginalLayoutOrder or item.LayoutOrder or 0
                    end
                    if page and page.MarkDirty then page.MarkDirty(item, false, true) end
                    break
                end
            end
        end
        if page and page.MarkDirty then page.MarkDirty(nil, true, true) end
    end

    inventoryUnlockManager.delete_item = function(self, cat, itemName)
        if cat == "Sword" then
            config.deleted_swords = config.deleted_swords or {}
            config.deleted_swords[itemName] = true
            if config.favorite_swords then config.favorite_swords[itemName] = nil end
            if self.selected_sword == itemName then self:restore_sword() end
        elseif cat == "Explosion" then
            config.deleted_explosions = config.deleted_explosions or {}
            config.deleted_explosions[itemName] = true
            if config.favorite_explosions then config.favorite_explosions[itemName] = nil end
            if self.selected_explosion == itemName then self.selected_explosion = nil end
        end
        pcall(configStorage.save)
        self:sync_fav_map(cat)
        if self.shop_controller then self:refresh_shop_item(cat, itemName, false) end
        self:refresh_selected()
    end

    inventoryUnlockManager.undelete_item = function(self, cat, itemName)
        if cat == "Sword" and config.deleted_swords then config.deleted_swords[itemName] = nil
        elseif cat == "Explosion" and config.deleted_explosions then config.deleted_explosions[itemName] = nil end
        pcall(configStorage.save)
        self:sync_fav_map(cat)
        if self.shop_controller then self:refresh_shop_item(cat, itemName, true) end
        self:refresh_selected()
    end

    inventoryUnlockManager.toggle_fav = function(self, cat, itemName)
        if self:is_deleted(cat, itemName) then return end
        if cat == "Sword" then
            config.favorite_swords = config.favorite_swords or {}
            config.favorite_swords[itemName] = config.favorite_swords[itemName] and nil or true
        elseif cat == "Explosion" then
            config.favorite_explosions = config.favorite_explosions or {}
            config.favorite_explosions[itemName] = config.favorite_explosions[itemName] and nil or true
        end
        pcall(configStorage.save)
        self:sync_fav_map(cat)
        local items = self.shop_controller and self.shop_controller._virtualItems and self.shop_controller._virtualItems[cat]
        local page = self.shop_controller and self.shop_controller._inventoryPages and self.shop_controller._inventoryPages[cat]
        local fav = self:is_fav(cat, itemName)
        if type(items) == "table" then
            for _, item in pairs(items) do
                if item.Name == itemName then
                    item.IsFavorited = fav
                    if item.OwnsItem and type(item.OwnsItem.Set) == "function" then
                        pcall(item.OwnsItem.Set, item.OwnsItem, true)
                    end
                    local origOrder = item.OriginalLayoutOrder or item.LayoutOrder or 0
                    item.OriginalLayoutOrder = origOrder
                    if fav then
                        item.LayoutOrder = origOrder - 1000
                        item.Name_ = "#" .. (item.Name_ or item.Name):gsub("^#", "")
                    else
                        item.LayoutOrder = origOrder
                        item.Name_ = (item.Name_ or item.Name):gsub("^#", "")
                    end
                    break
                end
            end
        end
        if page and page.MarkDirty then page.MarkDirty(nil, true, true) end
        self:refresh_selected()
    end

    inventoryUnlockManager.equip_sword = function(self, swordName, isRestore)
        if not self.swords then return false end
        if not isRestore and self:is_deleted("Sword", swordName) then
            self:undelete_item("Sword", swordName)
        end
        local sword = self.swords:GetSword(swordName)
        if not sword then return false end
        local char = localPlayer.Character
        if not char then return false end

        if not isRestore and not self.original_sword then
            self.original_sword = localPlayer:GetAttribute("CurrentlyEquippedSword") or char:GetAttribute("CurrentlyEquippedSword")
        end
        if isRestore then
            self.selected_sword = nil
        else
            self.selected_sword = sword.Name
            config.last_equipped_sword = sword.Name
            self:set_sword_override(true)
        end
        localPlayer:SetAttribute("CurrentlyEquippedSword", sword.Name)
        char:SetAttribute("CurrentlyEquippedSword", sword.Name)

        pcall(function()
            local fn = self.swords.EquipSwordTo
            for k, v in pairs(debug.getupvalues(fn)) do
                if v == true then
                    debug.setupvalue(fn, k, false)
                    break
                end
            end
        end)

        if not pcall(function() self.swords:EquipSwordTo(char, sword.Name) end) then
            return false
        end
        local model = char:FindFirstChild(sword.Name)
        if model then
            self:apply_chroma(model, sword)
        end
        if self.sword_fn then
            pcall(self.sword_fn, sword.Name)
        end
        return true
    end

    inventoryUnlockManager.restore_sword = function(self)
        if self.original_sword and self.original_sword ~= "" then
            self:equip_sword(self.original_sword, true)
        else
            self.selected_sword = nil
        end
        self.original_sword = nil
        self:set_sword_override(false)
    end

    inventoryUnlockManager.ensure_explosion_wrap = function(self)
        if self.explosion_hooked or not self.explosion_module then return end
        self.explosion_hooked = true
        self.explosion_original = self.explosion_module.PlayExplosion
        self.explosion_module.PlayExplosion = function(a, expName, c, d, e, f, targetChar)
            if inventoryUnlockManager.enabled and inventoryUnlockManager.selected_explosion and inventoryUnlockManager.selected_explosion ~= "" and f and targetChar == localPlayer.Character then
                expName = inventoryUnlockManager.selected_explosion
            end
            return inventoryUnlockManager.explosion_original(a, expName, c, d, e, f, targetChar)
        end
    end

    inventoryUnlockManager.equip_explosion = function(self, expName)
        if self:is_deleted("Explosion", expName) then
            self:undelete_item("Explosion", expName)
        end
        self.selected_explosion = expName
        config.last_equipped_explosion = expName
        self:ensure_explosion_wrap()
        return true
    end

    inventoryUnlockManager.bind_shadow = function(self, cat, shadow)
        if self.shadow_connections[shadow] then return end
        local function hide()
            if self.unlocked[cat] and shadow.Parent and shadow.Enabled then
                shadow.Enabled = false
            end
        end
        self.shadow_connections[shadow] = shadow:GetPropertyChangedSignal("Enabled"):Connect(hide)
        hide()
    end

    inventoryUnlockManager.refresh_visuals = function(self, cat)
        if not self.shop_controller then return end
        local page = self.shop_controller._inventoryPages[cat]
        local items = self.shop_controller._virtualItems[cat]
        if not page or not page.Scroll or type(items) ~= "table" then return end

        if not self.page_connections[cat] and page.ScrollingFrame then
            self.page_connections[cat] = page.ScrollingFrame.DescendantAdded:Connect(function(desc)
                if desc:IsA("GuiObject") then
                    deferTask(function()
                        self:slot_fav_visual(cat, desc)
                        local shadow = desc:FindFirstChild("Shadow") or (desc.Name == "Shadow" and desc)
                        if shadow and self.unlocked[cat] then
                            self:bind_shadow(cat, shadow)
                        end
                    end)
                end
            end)
        end

        deferTask(function()
            for _, item in pairs(items) do
                local ok, slot = pcall(page.Scroll.GetRenderedSlot, item)
                if ok and slot then
                    self:slot_fav_visual(cat, slot)
                    local shadow = slot:FindFirstChild("Shadow")
                    if shadow then
                        if self.unlocked[cat] then
                            self:bind_shadow(cat, shadow)
                        else
                            shadow.Enabled = not item.OwnsItem:Get()
                        end
                    end
                end
            end
        end)
    end

    inventoryUnlockManager.set_category_unlock = function(self, cat, enable)
        if not self.shop_controller then return end
        if enable then self:sync_fav_map(cat) end
        local items = self.shop_controller._virtualItems[cat]
        local page = self.shop_controller._inventoryPages[cat]
        if type(items) ~= "table" then return end

        if page and page.BeginBatch then page.BeginBatch() end
        if enable then
            self.unlocked[cat] = true
            local ownedSet = {}
            for _, item in pairs(items) do
                if item.InventoryKey then ownedSet[item.Name] = true end
            end
            for _, item in pairs(items) do
                if not self.unlock_originals[item] then
                    self.unlock_originals[item] = {
                        Section = item.Section,
                        ForceHide = item.ForceHide,
                        OriginalLayoutOrder = item.OriginalLayoutOrder or item.LayoutOrder,
                    }
                end
                local deleted = self:is_deleted(cat, item.Name)
                local sec = deleted and "Unowned" or "Owned"
                local dirty = false
                if item.Section ~= sec then
                    item.Section = sec
                    dirty = true
                end
                if item.OwnsItem and type(item.OwnsItem.Set) == "function" then
                    pcall(item.OwnsItem.Set, item.OwnsItem, not deleted)
                end
                local fav = not deleted and self:is_fav(cat, item.Name)
                item.IsFavorited = fav
                local origOrder = item.OriginalLayoutOrder or item.LayoutOrder or 0
                item.OriginalLayoutOrder = origOrder
                local newOrder = origOrder - (fav and 1000 or 0)
                if item.LayoutOrder ~= newOrder then
                    item.LayoutOrder = newOrder
                    dirty = true
                end
                local newName = fav and ("#" .. (item.Name_ or item.Name):gsub("^#", "")) or (item.Name_ or item.Name):gsub("^#", "")
                if item.Name_ ~= newName then
                    item.OriginalName_ = item.OriginalName_ or item.Name_
                    item.Name_ = newName
                    dirty = true
                end
                local hide = (not item.InventoryKey and ownedSet[item.Name]) or false
                if item.ForceHide ~= hide then
                    item.ForceHide = hide
                    dirty = true
                end
                if dirty and page and page.MarkDirty then
                    page.MarkDirty(item, false, true)
                end
            end
        else
            self.unlocked[cat] = nil
            for _, item in pairs(items) do
                local orig = self.unlock_originals[item]
                if orig then
                    local dirty = false
                    if item.Section ~= orig.Section then item.Section = orig.Section; dirty = true end
                    if item.ForceHide ~= orig.ForceHide then item.ForceHide = orig.ForceHide; dirty = true end
                    if dirty and page and page.MarkDirty then page.MarkDirty(item, false, true) end
                    self.unlock_originals[item] = nil
                end
            end
        end
        if page and page.MarkDirty then page.MarkDirty(nil, true, true) end
        if page and page.EndBatch then page.EndBatch() end
        self:refresh_visuals(cat)
    end

    inventoryUnlockManager.expected_size = function(self, cat)
        local count = 0
        if cat == "Sword" and self.swords then
            local ok, col = pcall(function() return self.swords:GetCollection() end)
            if ok and type(col) == "table" then
                for _ in pairs(col) do count = count + 1 end
            end
        elseif cat == "Explosion" then
            local miscFolder = ReplicatedStorage:FindFirstChild("Misc")
            local dataExp = miscFolder and miscFolder:FindFirstChild("DataExplosions")
            if dataExp then
                for _, child in ipairs(dataExp:GetChildren()) do
                    if not child:GetAttribute("Hidden") then count = count + 1 end
                end
            end
        end
        return count
    end

    inventoryUnlockManager.schedule_refresh = function(self, cat)
        self.refresh_generation[cat] = (self.refresh_generation[cat] or 0) + 1
        local gen = self.refresh_generation[cat]
        if type(self.shop_controller._loadInventoryPage) == "function" then
            pcall(self.shop_controller._loadInventoryPage, cat)
        end
        spawnTask(function()
            local expected = self:expected_size(cat)
            local lastCount = -1
            local stableFrames = 0
            for _ = 1, 120 do
                heartbeat:Wait()
                if not self.enabled or not self.unlocked[cat] or self.refresh_generation[cat] ~= gen then return end
                local items = self.shop_controller._virtualItems[cat]
                local currentCount = 0
                if type(items) == "table" then
                    for _, item in pairs(items) do
                        if not item.InventoryKey then currentCount = currentCount + 1 end
                    end
                end
                if currentCount == lastCount and currentCount > 0 then
                    stableFrames = stableFrames + 1
                else
                    stableFrames = 0
                    lastCount = currentCount
                end
                if (expected > 0 and currentCount >= expected) or (expected == 0 and stableFrames >= 5) then
                    heartbeat:Wait()
                    self:set_category_unlock(cat, true)
                    return
                end
            end
            if self.enabled and self.unlocked[cat] and self.refresh_generation[cat] == gen then
                self:set_category_unlock(cat, true)
            end
        end)
    end

    inventoryUnlockManager.refresh_selected = function(self)
        if not self.shop_controller or not self.shop then return end
        local sel = self.shop_controller._selectedItem
        if not sel then return end
        local buyBtn = self.shop.Holder.InfoBG:FindFirstChild("BuyButton")
        local favBtn = self.shop.Holder:FindFirstChild("Favorite")
        local delBtn = self.shop.Holder.InfoBG:FindFirstChild("Delete")

        if self.enabled and self.unlocked[sel.type] and (sel.type == "Sword" or sel.type == "Explosion") then
            local vItems = self.shop_controller._virtualItems and self.shop_controller._virtualItems[sel.type]
            local item = vItems and vItems[sel.key or sel.name]
            if self:is_deleted(sel.type, sel.name) or (item and item.Section == "Unowned") then
                if buyBtn then buyBtn.Visible = false end
                if favBtn then favBtn.Visible = false end
                if delBtn then delBtn.Visible = true end
            else
                if buyBtn then
                    buyBtn.Visible = true
                    if buyBtn:FindFirstChild("PriceTag") and buyBtn.PriceTag:FindFirstChild("TextLabel") then
                        buyBtn.PriceTag.TextLabel.Visible = true
                        buyBtn.PriceTag.TextLabel.Text = "Equip"
                    end
                    if buyBtn:FindFirstChild("PriceTag") and buyBtn.PriceTag:FindFirstChild("Price") then
                        buyBtn.PriceTag.Price.Visible = false
                    end
                end
                if favBtn then
                    favBtn.Visible = true
                    local fav = self:is_fav(sel.type, sel.name)
                    favBtn.Image = fav and "rbxassetid://15697987058" or "rbxassetid://15697981750"
                    favBtn.HoverImage = fav and "rbxassetid://15697983062" or "rbxassetid://15697987058"
                end
                if delBtn then delBtn.Visible = true end
            end
        end
    end

    inventoryUnlockManager.set_modern_unlock = function(self, cat, enable)
        local api = self.shop_api
        local bases = api and api.OwnedBases and api.OwnedBases[cat]
        if type(bases) ~= "table" then return end
        for k, base in pairs(bases) do
            local ok1, parsed = pcall(api.ParseItemKey, api, cat, {Name = k})
            local copies = nil
            if ok1 and parsed then
                local ok2, data = pcall(api.GetItemData, api, cat, parsed)
                if ok2 and type(data) == "table" then
                    copies = data.OwnedCopies
                end
            end
            if enable and copies and type(copies.Get) == "function" and type(copies.Set) == "function" then
                if not self.modern_originals[copies] then
                    local ok3, val = pcall(copies.Get, copies)
                    if ok3 then self.modern_originals[copies] = {Value = val} end
                end
                local ok3, val = pcall(copies.Get, copies)
                if ok3 and (type(val) ~= "number" or val < 1) then
                    pcall(copies.Set, copies, 1)
                end
            end
            if base and type(base.SetTag) == "function" then
                pcall(base.SetTag, base, self.modern_tag, enable and true or nil)
            end
            if not enable and copies then
                local orig = self.modern_originals[copies]
                if orig and type(copies.Set) == "function" then
                    local isOwned = false
                    if base and base.State and type(base.State.Get) == "function" then
                        local ok4, st = pcall(base.State.Get, base.State)
                        isOwned = ok4 and st == true
                    end
                    if not isOwned then
                        pcall(copies.Set, copies, orig.Value)
                    end
                    self.modern_originals[copies] = nil
                end
            end
        end
    end

    inventoryUnlockManager.hook_modern_shop = function(self)
        local api = self.shop_api
        if not api or self.original_set_equipped or type(api.SetEquipped) ~= "function" then return end
        self.original_set_equipped = api.SetEquipped
        api.SetEquipped = function(selfApi, ...)
            local args = {...}
            local itemType, itemName = args[1], args[2]
            if type(itemType) == "table" then
                itemName = itemType.Name
                itemType = itemType.ItemType
            elseif type(itemName) == "table" then
                itemName = itemName.Name
            end
            local bases = api.OwnedBases
            local catBases = type(bases) == "table" and bases[itemType]
            local inBases = type(catBases) == "table" and catBases[itemName] ~= nil
            if inventoryUnlockManager.enabled and (inBases or itemType == "Sword" or itemType == "Explosion") then
                if (itemType == "Sword" or tostring(itemType):lower():find("sword")) and inventoryUnlockManager:equip_sword(itemName, false) then
                    return true
                end
                if itemType == "Explosion" or tostring(itemType):lower():find("explosion") then
                    return inventoryUnlockManager:equip_explosion(itemName)
                end
            end
            return inventoryUnlockManager.original_set_equipped(selfApi, unpack(args))
        end
    end

    inventoryUnlockManager.hook_shop = function(self)
        local shop = localPlayer:WaitForChild("PlayerGui"):FindFirstChild("Shop")
        local holder = shop and shop:FindFirstChild("Holder")
        local infoBG = holder and holder:FindFirstChild("InfoBG")
        local buyButton = infoBG and infoBG:FindFirstChild("BuyButton")
        if not shop or not buyButton then return false end

        self.shop = shop
        for _, conn in ipairs(getconnections(buyButton.Activated)) do
            if conn and conn.Function then
                insertIntoTable(self.original_buy_fns, conn.Function)
                conn:Disable()
            end
        end

        local favBtn = holder:FindFirstChild("Favorite")
        if favBtn then
            for _, conn in ipairs(getconnections(favBtn.Activated)) do
                if conn and conn.Function then conn:Disable() end
            end
            favBtn.Activated:Connect(function()
                local sel = self.shop_controller and self.shop_controller._selectedItem
                if sel and self.enabled and (sel.type == "Sword" or sel.type == "Explosion") then
                    self:toggle_fav(sel.type, sel.name)
                end
            end)
        end

        local delBtn = infoBG:FindFirstChild("Delete")
        if delBtn then
            for _, conn in ipairs(getconnections(delBtn.Activated)) do
                if conn and conn.Function then conn:Disable() end
            end
            delBtn.Activated:Connect(function()
                local sel = self.shop_controller and self.shop_controller._selectedItem
                if not sel or not self.enabled or (sel.type ~= "Sword" and sel.type ~= "Explosion") then return end
                if self:is_deleted(sel.type, sel.name) then
                    self:undelete_item(sel.type, sel.name)
                else
                    self:delete_item(sel.type, sel.name)
                end
            end)
        end

        game:GetService("GuiService"):GetPropertyChangedSignal("SelectedObject"):Connect(function()
            if self.enabled and self.shop and self.shop.Enabled then
                deferTask(function() self:refresh_selected() end)
            end
        end)

        self.shop_controller.itemSelected:Connect(function(sel)
            if sel and self.unlocked[sel.type] then
                self:set_category_unlock(sel.type, true)
            end
            deferTask(function() self:refresh_selected() end)
        end)

        buyButton.Activated:Connect(function()
            local sel = self.shop_controller._selectedItem
            if not sel then return end
            if self.enabled and self.unlocked[sel.type] then
                if self:is_deleted(sel.type, sel.name) then
                    self:undelete_item(sel.type, sel.name)
                end
                if sel.type == "Sword" then
                    if self:equip_sword(sel.name, false) then
                        buyButton.PriceTag.TextLabel.Text = "Equipped"
                    end
                    return
                elseif sel.type == "Explosion" then
                    self:equip_explosion(sel.name)
                    buyButton.PriceTag.TextLabel.Text = "Equipped"
                    return
                end
            end
            for _, fn in ipairs(self.original_buy_fns) do
                spawnTask(fn)
            end
        end)

        local function onShopOpen()
            if not self.shop.Enabled or not self.enabled then return end
            for _, cat in ipairs({"Sword", "Explosion"}) do
                if self.unlocked[cat] then
                    self:schedule_refresh(cat)
                end
            end
        end

        self.shop:GetPropertyChangedSignal("Enabled"):Connect(function()
            if self.shop.Enabled then deferTask(onShopOpen) end
        end)
        if self.shop.Enabled then deferTask(onShopOpen) end
        return true
    end

    inventoryUnlockManager.hook_sword_fx = function(self)
        local shared = ReplicatedStorage:FindFirstChild("Shared")
        local swordsMod = shared and shared:FindFirstChild("ReplicatedInstances") and shared.ReplicatedInstances:FindFirstChild("Swords")
        if swordsMod then
            local ok, mod = pcall(require, swordsMod)
            if ok then self.swords = mod end
        end
        local parryAll = remotes and remotes:FindFirstChild("ParrySuccessAll")
        if parryAll then
            parryAll.OnClientEvent:Connect(function(...)
                if not self.enabled or not self.selected_sword or not self.play_parry then return end
                local args = {...}
                local sword = self.swords and self.swords:GetSword(self.selected_sword)
                if sword and args[4] and tostring(args[4]) == name then
                    args[1] = sword.SlashName
                    args[3] = sword.Name
                end
                return self.play_parry(unpack(args))
            end)
        end
    end

    inventoryUnlockManager.setup_character = function(self, char)
        if self.character_connection then
            pcall(function() self.character_connection:Disconnect() end)
            self.character_connection = nil
        end
        if not char then return end
        if self.enabled and config.last_equipped_sword and config.last_equipped_sword ~= "" then
            deferTask(function()
                if self.enabled and config.last_equipped_sword ~= "" then
                    self:equip_sword(config.last_equipped_sword, false)
                end
            end)
        end
        local function onChild(child)
            if not self.enabled or not child:IsA("Model") or not self.swords or not self.selected_sword then return end
            local sword = self.swords:GetSword(child.Name)
            if not sword then return end
            if child.Name ~= self.selected_sword then
                local sel = self.selected_sword
                deferTask(function()
                    if self.enabled and self.selected_sword == sel then
                        self:equip_sword(sel, false)
                    end
                end)
            else
                self:apply_chroma(child, sword)
                if self.sword_fn then
                    deferTask(function()
                        if self.enabled and self.selected_sword == child.Name then
                            pcall(self.sword_fn, child.Name)
                        end
                    end)
                end
            end
        end
        self.character_connection = char.ChildAdded:Connect(onChild)
        for _, child in ipairs(char:GetChildren()) do onChild(child) end
    end

    inventoryUnlockManager.hook_chroma = function(self)
        if self.chroma_bound then return end
        self.chroma_bound = true
        self.added_connection = localPlayer.CharacterAdded:Connect(function(char)
            self:setup_character(char)
        end)
        if localPlayer.Character then
            deferTask(function() self:setup_character(localPlayer.Character) end)
        end
        self.sword_attr_connection = localPlayer:GetAttributeChangedSignal("CurrentlyEquippedSword"):Connect(function()
            local sel = self.selected_sword
            if not self.enabled or not sel or localPlayer:GetAttribute("CurrentlyEquippedSword") == sel then return end
            localPlayer:SetAttribute("CurrentlyEquippedSword", sel)
            if localPlayer.Character then
                localPlayer.Character:SetAttribute("CurrentlyEquippedSword", sel)
            end
            if self.sword_fn then pcall(self.sword_fn, sel) end
        end)
    end

    inventoryUnlockManager.initialize = function(self)
        local uiFolder = ReplicatedStorage.Controllers:FindFirstChild("UI")
        local scMod = uiFolder and uiFolder:FindFirstChild("ShopController")
        local apiMod = uiFolder and uiFolder:FindFirstChild("ShopControllerAPI")
        local ok1, sc = pcall(require, scMod)
        local ok2, api = pcall(require, apiMod)
        if not ok1 or type(sc) ~= "table" then sc = nil end
        if not ok2 or type(api) ~= "table" then api = nil end
        if not sc and not api then return end

        self.shop_controller = sc
        self.shop_api = api
        self:hook_sword_fx()
        self:hook_chroma()
        pcall(function()
            self.explosion_module = require(ReplicatedStorage.Controllers.VFXController)
        end)
        self:ensure_explosion_wrap()
        if self.shop_controller then self:hook_shop() end
        if self.shop_api then self:hook_modern_shop() end
        self.ready = true
        self:set_enabled(self.enabled)

        if self.enabled and config.last_equipped_sword and config.last_equipped_sword ~= "" then
            deferTask(function()
                if self.enabled and config.last_equipped_sword ~= "" then
                    self:equip_sword(config.last_equipped_sword, false)
                end
            end)
        end
        if self.enabled and config.last_equipped_explosion and config.last_equipped_explosion ~= "" then
            deferTask(function()
                if self.enabled and config.last_equipped_explosion ~= "" then
                    self:equip_explosion(config.last_equipped_explosion)
                end
            end)
        end
    end

    inventoryUnlockManager.set_enabled = function(self, state)
        local enabled = (state == true)
        self.enabled = enabled
        config.unlock_all = enabled
        if not self.ready then return end
        for _, cat in ipairs({"Sword", "Explosion"}) do
            if self.enabled then
                if self.shop_controller then
                    self:set_category_unlock(cat, true)
                    self:schedule_refresh(cat)
                end
                self:set_modern_unlock(cat, true)
            else
                if self.shop_controller then
                    self.refresh_generation[cat] = (self.refresh_generation[cat] or 0) + 1
                    self:set_category_unlock(cat, false)
                end
                self:set_modern_unlock(cat, false)
            end
        end
        if not self.enabled then
            self:restore_sword()
            self.selected_explosion = nil
        else
            self:refresh_selected()
        end
    end

    spawnTask(function()
        inventoryUnlockManager:initialize()
    end)

    miscSection:toggle({
        name = "unlock all",
        flag = "misc.unlock_all",
        default = config.unlock_all or false,
        cb = function(unlockAll)
            inventoryUnlockManager:set_enabled(unlockAll == true)
        end,
    })
end

