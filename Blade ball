local function isPhantomPending(ball)
    local pData = detectionState.phantom_data
    if not pData then return false end
    if tick() >= pData.expires then
        detectionState.phantom_data = nil
        return false
    end
    local enemy = pData.user
    if not enemy or not enemy.Parent then
        return false
    end
    if tostring(ball and ball:GetAttribute("target") or "") ~= enemy.Name then
        pData.last_pos = nil
        pData.released = false
        return false
    end
    local bPos = ballState.position(ball)
    if pData.last_pos and (bPos - pData.last_pos).Magnitude > 0.01 then
        pData.released = true
    end
    pData.last_pos = bPos
    return not pData.released
end

local function isBackwardsCurve(ball, rootPos, vel)
    if not ball or not rootPos or not vel or vel.Magnitude < 1 then
        return false
    end
    local bPos = ballState.position(ball)
    local diff = rootPos - bPos
    if diff.Magnitude < 0.01 then
        return false
    end
    local toPlayer = diff.Unit
    local moveDir = vel.Unit
    return moveDir:Dot(toPlayer) < -0.3
end

local function lerpValue(a, b, t)
    return a + (b - a) * t
end

