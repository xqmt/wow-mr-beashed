configStorage.path = configStorage.folder .. "/config.json"

configStorage.ensure_folder = function()
    if type(makefolder) ~= "function" then return end
    local exists = false
    if type(isfolder) == "function" then
        local ok, res = pcall(isfolder, configStorage.folder)
        exists = ok and res
    end
    if not exists then
        pcall(makefolder, configStorage.folder)
    end
end

configStorage.copy = function(val)
    if type(val) ~= "table" then return val end
    local t = {}
    for k, v in pairs(val) do
        t[k] = configStorage.copy(v)
    end
    return t
end

configStorage.equal = function(a, b)
    if a == b then return true end
    if type(a) ~= "table" or type(b) ~= "table" then return false end
    for k, v in pairs(a) do
        if type(v) == "table" then
            if not configStorage.equal(v, b[k]) then return false end
        elseif b[k] ~= v then
            return false
        end
    end
    for k in pairs(b) do
        if a[k] == nil then return false end
    end
    return true
end

configStorage.valid_key = function(val)
    if type(val) ~= "string" then return false end
    local ok, kc = pcall(function() return Enum.KeyCode[val] end)
    return ok and kc ~= nil
end

configStorage.normalize = function(input)
    local t = {}
    for k, def in pairs(configStorage.defaults) do
        local v = type(input) == "table" and input[k] or nil
        if type(def) == "table" then
            t[k] = type(v) == "table" and configStorage.copy(v) or configStorage.copy(def)
        else
            t[k] = type(v) == type(def) and v or def
        end
    end
    t.accuracy = clampValue(floorValue(t.accuracy + 0.5), 1, 100)
    t.spam_threshold = clampValue(floorValue(t.spam_threshold + 0.5), 1, 3)
    t.spam_cps = clampValue(roundValue(t.spam_cps), 50, 500)
    t.immortal_range = clampValue(roundValue(t.immortal_range), 1, 50)
    if not findInTable(curveMethods, t.curve_method) then
        t.curve_method = configStorage.defaults.curve_method
    end
    if not findInTable(immortalModes, t.immortal_mode) then
        t.immortal_mode = configStorage.defaults.immortal_mode
    end
    if not configStorage.valid_key(t.manual_spam) then
        t.manual_spam = configStorage.defaults.manual_spam
    end
    if not configStorage.valid_key(t.triggerbot_key) then
        t.triggerbot_key = configStorage.defaults.triggerbot_key
    end
    return t
end

do
    local data = nil
    if configStorage.storage_ok then
        configStorage.ensure_folder()
        pcall(function()
            data = httpService:JSONDecode(readfile(configStorage.path))
        end)
    end
