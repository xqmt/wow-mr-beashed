eventCapture.polygon = function(seed)
    local serverTimeStr = tostring(floorValue(Workspace:GetServerTimeNow() * 100))
    local tokenKey = eventCapture.token_fn(seed, "TIME")
    local out = createTable(#serverTimeStr)
    for i = 1, #serverTimeStr do
        out[i] = stringChar(bitwiseXor((stringByte(serverTimeStr, i) + i) % 256, stringByte(tokenKey, (i - 1) % #tokenKey + 1)))
    end
    return concatTable(out)
end

eventCapture.unhook = function()
    for mt, orig in pairs(eventCapture.originals) do
        pcall(function()
            setreadonly(mt, false)
            mt.__index = orig
            setreadonly(mt, true)
        end)
    end
    clearTable(eventCapture.hooked)
    clearTable(eventCapture.originals)
end

eventCapture.valid_args = function(args)
    return #args == 8
        and type(args[2]) == "string"
        and type(args[3]) == "string"
        and type(args[4]) == "number"
        and typeof(args[5]) == "CFrame"
        and type(args[6]) == "table"
        and type(args[7]) == "table"
        and type(args[8]) == "boolean"
end

eventCapture.hook = function(remote)
    if next(eventCapture.captured) ~= nil then return end
    local mt = getrawmetatable(remote)
    if eventCapture.hooked[mt] then return end
    eventCapture.hooked[mt] = true
    setreadonly(mt, false)
    local origIndex = mt.__index
    eventCapture.originals[mt] = origIndex
    mt.__index = function(self, key)
        if (key == "FireServer" and self:IsA("RemoteEvent")) or (key == "InvokeServer" and self:IsA("RemoteFunction")) then
            return function(obj, ...)
                local args = {...}
                if eventCapture.valid_args(args) then
                    eventCapture.captured[self] = args
                    eventCapture.unhook()
                end
                return origIndex(self, key)(obj, unpack(args))
            end
        end
        return origIndex(self, key)
    end
    setreadonly(mt, true)
end

