-- Spam Controller
local spamController = {
    distance = 0,
    last_auto = 0,
    manual_on = false,
    manual_key = Enum.KeyCode[config.manual_spam] or Enum.KeyCode.E,
    lastManualFire = 0,
}

spamController.get_interval = function()
    local cps = clampValue(roundValue(tonumber(config.spam_cps) or 120), 50, 500)
    return 1 / cps
end

spamController.perform = function(ctx)
    local b = ballState.get()
    local current = targetManager.current or targetManager.closest()
    if not b then
        return false
    end
    if not current or not current.PrimaryPart then
        return false
    end
    local char = localPlayer.Character
    local root = char and char.PrimaryPart
    if not root then
        return false
    end
    local vel = b.AssemblyLinearVelocity
    local speed = vel.Magnitude
    local offset = root.Position - ballState.position(b)
    local dot = offset.Magnitude > 0 and (offset.Unit:Dot(speed > 0 and vel.Unit or Vector3.zero)) or 0
    local distToTarget = localPlayer:DistanceFromCharacter(current.PrimaryPart.Position)
    local window = ctx.Ping + minValue(speed / 6, 95)

    if ctx.Entity_Properties and ctx.Entity_Properties.distance and ctx.Entity_Properties.distance > window then
        return spamController.distance
    end
    if ctx.Ball_Properties and ctx.Ball_Properties.Distance and window < ctx.Ball_Properties.Distance then
        return spamController.distance
    end
    if window < distToTarget then
        return spamController.distance
    end

    spamController.distance = window - clampValue(dot, -1, 0) * (5 - minValue(speed / 5, 5))
    return spamController.distance
end

spamController.auto_check = function()
    if not config.auto_spam or not _G.oxymod then return end

    local ball = ballState.get()
    if not ball then return end
    if not ball:FindFirstChild("zoomies") then return end

    targetManager.closest()
    if not targetManager.current or not targetManager.current.PrimaryPart then return end

    local now = tick()
    local reach = spamController.perform({
        Ball_Properties = ballState.props(),
        Entity_Properties = targetManager.props(),
        Ping = clampValue(dataPing:GetValue() / 10, 1, 16),
    })

    local character = localPlayer.Character
    local primaryPart = character and character.PrimaryPart
    if not primaryPart then return end

    local ballDist = (primaryPart.Position - ballState.position(ball)).Magnitude
    local attr = ball:GetAttribute("target")
    if not attr then return end

    local targetDist = localPlayer:DistanceFromCharacter(targetManager.current.PrimaryPart.Position)
    if targetDist > reach or ballDist > reach then return end
    if character:GetAttribute("Pulsed") then return end
    if attr == name and targetDist > 30 and ballDist > 30 then return end

    local threshold = clampValue(floorValue((config.spam_threshold or 3) + 0.5), 1, 3)
    local interval = spamController.get_interval()
    if ballDist <= reach and parryController.count > threshold and now - spamController.last_auto >= interval then
        spamController.last_auto = now
        parryController.fire(true)
    end
end

spamController.set_auto = function(autoSpam)
    local enabled = (autoSpam == true)
    config.auto_spam = enabled
    spamController.last_auto = 0

    if runtimeConnections.auto_spam then
        runtimeConnections.auto_spam:Disconnect()
        runtimeConnections.auto_spam = nil
    end

    if enabled and _G.oxymod then
        runtimeConnections.auto_spam = preSimulation:Connect(spamController.auto_check)
    end
end

spamController.set_manual = function(val)
    local manualOn = (val == true)
    spamController.manual_on = manualOn
    spamController.lastManualFire = 0

    if runtimeConnections.manual_spam then
        runtimeConnections.manual_spam:Disconnect()
        runtimeConnections.manual_spam = nil
    end

    if manualOn and _G.oxymod then
        runtimeConnections.manual_spam = preSimulation:Connect(function()
            if not spamController.manual_on then return end
            local now = tick()
            local interval = spamController.get_interval()
            if now - spamController.lastManualFire < interval then return end
            spamController.lastManualFire = now
            parryController.fire(true)
        end)
    end

    if config.manual_notify then
        notificationService:notify({
            title = "manual spam",
            content = manualOn and "on" or "off",
            duration = 4,
        })
    end
end

