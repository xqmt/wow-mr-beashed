Tabs.Settings:Section({ Title = "Script Session" })

local function unloadScript()
    for _, conn in pairs(ZeroHub.Connections) do
        pcall(function() conn:Disconnect() end)
    end

    for _, inst in ipairs(ZeroHub.CreatedInstances) do
        pcall(function() inst:Destroy() end)
    end

    pcall(function()
        if flying then stopFly() end
    end)
    pcall(function()
        if godLoopConn then godLoopConn:Disconnect() end
        if godRespawnConn then godRespawnConn:Disconnect() end
        if antiFallLoopConn then antiFallLoopConn:Disconnect() end
        if antiFallRespawnConn then antiFallRespawnConn:Disconnect() end
    end)

    pcall(function()
        Workspace.Gravity = 196.2
        Workspace.FallenPartsDestroyHeight = -500
        Lighting.FogEnd = 1000
        Lighting.FogStart = 0
        settings().Physics.AllowSleep = true
        LocalPlayer.ReplicationFocus = nil
    end)

    pcall(function()
        local island = Workspace:FindFirstChild("Island")
        if island then
            for _, part in ipairs(island:GetChildren()) do
                if part:IsA("BasePart") and part.Name == "LowerRocks" then
                    part.CanCollide = false
                end
            end
        end
    end)

    pcall(function() Window:Destroy() end)
    getgenv()._ZeroHub = nil
end

ZeroHub.Unload = unloadScript

Tabs.Settings:Button({
    Title = "Unload flow",
    Desc = "Restores character, disconnects all loops, and closes GUI",
    Callback = function()
        unloadScript()
        notify("flow.xyz", "Unloaded successfully")
    end
})
