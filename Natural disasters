                if v:IsA("BasePart") then
                    addTornadoPart(v)
                end
            end
        else
            for part, oldCan in pairs(Tornado.OldCollisions) do
                if part and part.Parent then
                    part.CanCollide = oldCan
                end
            end
            table.clear(Tornado.PartList)
            table.clear(Tornado.OldCollisions)
        end
    end
})

